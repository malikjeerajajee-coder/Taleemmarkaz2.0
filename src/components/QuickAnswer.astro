---
const { question, answer } = Astro.props;
---

<div class="bg-blue-50 border-l-4 border-blue-600 p-6 md:p-8 rounded-r-xl my-8">
  <h2 class="text-xl font-bold text-blue-900 mb-3 flex items-center gap-2">
    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
    {question}
  </h2>
  <p class="text-blue-800 text-lg leading-relaxed font-medium">
    {answer}
  </p>
</div>