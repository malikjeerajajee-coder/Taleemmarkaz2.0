---
import Link from '../components/Link.astro';
---
<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo -->
      <Link href={`${import.meta.env.BASE_URL}/`} class="flex items-center gap-2">
        <div class="w-9 h-9 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">T</div>
        <span class="text-xl font-extrabold text-slate-900 tracking-tight">Taleem<span class="text-blue-600">Markaz</span></span>
      </Link>
      
      <!-- Desktop Nav -->
      <nav class="hidden lg:flex space-x-6">
        <Link href={`${import.meta.env.BASE_URL}/notes/`} class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors">Notes</Link>
        <Link href={`${import.meta.env.BASE_URL}/past-papers/`} class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors">Past Papers</Link>
        <Link href={`${import.meta.env.BASE_URL}/pairing-schemes/`} class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors">Pairing Schemes</Link>
        <Link href={`${import.meta.env.BASE_URL}/date-sheets/`} class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors">Date Sheets</Link>
      </nav>

      <!-- CTA -->
      <div class="hidden lg:flex items-center space-x-6">
        <Link href={`${import.meta.env.BASE_URL}/result-gazettes/`} class="text-sm font-semibold text-slate-600 hover:text-blue-600">Results</Link>
        <Link href={`${import.meta.env.BASE_URL}/about/`} class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors">About Us</Link>
      </div>

      <!-- Mobile Menu Button -->
      <button id="menu-toggle" type="button" class="lg:hidden text-slate-600 p-2 hover:bg-slate-100 rounded-lg transition-colors" aria-label="Open navigation" aria-expanded="false">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>