---
const { 
  title = "Learn Better. Prepare Smarter. Grow Further.",
  description = "Explore educational resources, study materials, and examination preparation content designed to support students throughout their academic journey.",
  primaryText = "Explore TaleemMarkaz",
  primaryUrl = "/",
  secondaryText = "Contact Us",
  secondaryUrl = "/contact/"
} = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 pb-16">
  <div class="bg-slate-900 rounded-2xl p-8 md:p-12 text-center text-white border border-slate-800">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-5 tracking-tight">
      {title}
    </h2>
    <p class="text-slate-300 max-w-2xl mx-auto mb-8 text-lg">
      {description}
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={primaryUrl} class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-3 rounded-lg font-bold transition-colors">
        {primaryText}
      </a>
      {secondaryText && (
        <a href={secondaryUrl} class="bg-white text-slate-900 hover:bg-slate-100 px-6 py-3 rounded-lg font-bold transition-colors">
          {secondaryText}
        </a>
      )}
    </div>
  </div>
</section>