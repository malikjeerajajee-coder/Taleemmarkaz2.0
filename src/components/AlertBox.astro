---
const { 
  type = "info", // Options: info, warning, success, danger
  title = "",
  theme = "blue"
} = Astro.props;

const styles = {
  info: { bg: "bg-blue-50", border: "border-blue-200", text: "text-blue-900", icon: "text-blue-600", iconSvg: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
  warning: { bg: "bg-orange-50", border: "border-orange-200", text: "text-orange-900", icon: "text-orange-600", iconSvg: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" },
  success: { bg: "bg-emerald-50", border: "border-emerald-200", text: "text-emerald-900", icon: "text-emerald-600", iconSvg: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
  danger: { bg: "bg-red-50", border: "border-red-200", text: "text-red-900", icon: "text-red-600", iconSvg: "M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" }
};
const style = styles[type] || styles.info;
---

<div class={`${style.bg} border ${style.border} rounded-xl p-6 my-6`}>
  {title && (
    <h3 class={`text-lg font-bold ${style.text} mb-3 flex items-center gap-2`}>
      <svg class={`w-5 h-5 ${style.icon}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={style.iconSvg}/></svg>
      {title}
    </h3>
  )}
  <div class={`text-sm ${style.text} leading-relaxed`}>
    <slot />
  </div>
</div>