---
const { pdfUrl, title = "Document Viewer", downloadName = "document.pdf" } = Astro.props;
---

<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden my-8">
  <!-- Toolbar -->
  <div class="bg-slate-100 border-b border-slate-200 p-4 flex flex-col sm:flex-row justify-between items-center gap-3">
    <h3 class="font-bold text-slate-900 text-sm">{title}</h3>
    <a href={pdfUrl} download={downloadName} class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-2 px-4 rounded-lg transition-colors flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      Download PDF
    </a>
  </div>
  
  <!-- Viewer -->
  <div class="w-full h-[600px] bg-slate-200">
    <iframe src={`${pdfUrl}#toolbar=0`} class="w-full h-full" title={title}></iframe>
  </div>
</div>