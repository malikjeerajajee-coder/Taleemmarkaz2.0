---
const { href, ...props } = Astro.props;

// 1. Get the base URL from config (either "/" or "/Taleemmarkaz2.0/")
const base = import.meta.env.BASE_URL;

// 2. Prevent double slashes
const cleanHref = href.startsWith('/') ? href.slice(1) : href;

// 3. Create the perfect path
const finalHref = href.startsWith('http') ? href : `${base}${cleanHref}`;
---

<a href={finalHref} {...props}>
  <slot />
</a>
