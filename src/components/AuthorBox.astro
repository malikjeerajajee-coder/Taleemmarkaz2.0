---

const { 
  name = "Malik Muhammad Ahsan Jahangir", 
  role = "Lead Academic Author", 
  qualifications = "MPhil Biotechnology",
  university = "",
  initials = "MA",
  theme = "blue", // Options: blue, teal, emerald, green
  publishedDate = null,
  updatedDate = "Nov 8, 2026",
  authorUrl = "/authors/"
} = Astro.props;

const themeClasses = {
  blue: { bg: "bg-blue-600", border: "border-blue-100", icon: "text-blue-600" },
  teal: { bg: "bg-teal-600", border: "border-teal-100", icon: "text-teal-600" },
  emerald: { bg: "bg-emerald-600", border: "border-emerald-100", icon: "text-emerald-600" },
  green: { bg: "bg-green-600", border: "border-green-100", icon: "text-green-600" },
};
const currentTheme = themeClasses[theme] || themeClasses.blue;
---

<div class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-2xl p-5 md:p-6 text-left">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="flex items-center gap-4">
      <div class={`w-14 h-14 md:w-16 md:h-16 ${currentTheme.bg} text-white rounded-full flex items-center justify-center font-bold text-xl md:text-2xl shrink-0 border-4 ${currentTheme.border}`}>
        {initials}
      </div>
      <div>
        <div class="flex items-center gap-1.5 mb-1">
          <svg class={`w-4 h-4 ${currentTheme.icon}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Academically Reviewed By</span>
        </div>
        <a href={authorUrl} class="block text-lg md:text-xl font-extrabold text-slate-900 hover:text-blue-600 transition-colors">
          {name}
        </a>
        <p class="text-sm text-slate-600 mt-0.5">
          {role} {university ? `| ${university}` : ""} <br class="sm:hidden" /> {qualifications}
        </p>
      </div>
    </div>

    <div class="flex flex-row md:flex-col lg:flex-row gap-6 md:gap-2 lg:gap-6 text-sm text-slate-500 md:border-l md:border-slate-200 md:pl-6 pt-4 md:pt-0 border-t md:border-t-0 border-slate-200">
      {publishedDate && (
        <div>
          <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Published</span>
          <time class="font-semibold text-slate-700">{publishedDate}</time>
        </div>
      )}
      <div>
        <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Updated</span>
        <time class="font-semibold text-slate-700">{updatedDate}</time>
      </div>
    </div>
  </div>
</div>