---
const { 
  name = "Malik Muhammad Ahsan Jahangir", 
  role = "Lead Academic Author", 
  qualifications = "MPhil Biotechnology",
  university = "",
  initials = "MA",
  theme = "blue", // Options: blue, teal, emerald, green, purple, orange
  publishedDate = null,
  updatedDate = "Nov 8, 2026",
  authorUrl = "/authors/"
} = Astro.props;

const themeClasses = {
  blue: { bg: "bg-blue-600", border: "border-blue-100", icon: "text-blue-600" },
  teal: { bg: "bg-teal-600", border: "border-teal-100", icon: "text-teal-600" },
  emerald: { bg: "bg-emerald-600", border: "border-emerald-100", icon: "text-emerald-600" },
  green: { bg: "bg-green-600", border: "border-green-100", icon: "text-green-600" },
  purple: { bg: "bg-purple-600", border: "border-purple-100", icon: "text-purple-600" },
  orange: { bg: "bg-orange-600", border: "border-orange-100", icon: "text-orange-600" },
};
const currentTheme = themeClasses[theme] || themeClasses.blue;
---

<!-- Slimmer, more compact card -->
<div class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-xl p-4 md:p-5 text-left mt-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    
    <div class="flex items-center gap-3">
      <!-- Smaller Avatar -->
      <div class={`w-10 h-10 md:w-12 md:h-12 ${currentTheme.bg} text-white rounded-full flex items-center justify-center font-bold text-sm md:text-base shrink-0 border-2 ${currentTheme.border}`}>
        {initials}
      </div>
      <div>
        <div class="flex items-center gap-1 mb-0.5">
          <svg class={`w-3.5 h-3.5 ${currentTheme.icon}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Academically Reviewed By</span>
        </div>
        <a href={authorUrl} class="block text-base font-extrabold text-slate-900 hover:text-blue-600 transition-colors leading-tight">
          {name}
        </a>
        <p class="text-xs text-slate-600 mt-0.5">
          {role} {university ? `| ${university}` : ""} <br class="sm:hidden" /> {qualifications}
        </p>
      </div>
    </div>

    <!-- Smaller Date section -->
    <div class="flex flex-row sm:flex-col lg:flex-row gap-4 sm:gap-1 lg:gap-4 text-xs text-slate-500 sm:border-l sm:border-slate-200 sm:pl-4 pt-3 sm:pt-0 border-t sm:border-t-0 border-slate-200">
      {publishedDate && (
        <div>
          <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Published</span>
          <time class="font-semibold text-slate-700">{publishedDate}</time>
        </div>
      )}
      <div>
        <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Updated</span>
        <time class="font-semibold text-slate-700">{updatedDate}</time>
      </div>
    </div>

  </div>
</div>