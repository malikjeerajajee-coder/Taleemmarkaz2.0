---
import Link from '../components/Link.astro';
---
<footer class="bg-white border-t border-slate-200 pt-16 pb-8 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8 mb-12">
      
      <!-- Column 1: Brand & Author (Takes up 4 columns) -->
      <div class="col-span-1 md:col-span-4">
        <Link href={`${import.meta.env.BASE_URL}/`} class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-lg">T</div>
          <span class="text-xl font-extrabold text-slate-900 tracking-tight">Taleem<span class="text-blue-600">Markaz</span></span>
        </Link>
        <p class="text-sm text-slate-500 mb-6 leading-relaxed">
          Pakistan's premier free educational platform. Verified notes, past papers, and exam prep for Matric and Intermediate students.
        </p>
        
        <!-- Author E-E-A-T Box -->
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-start gap-3">
          <div class="w-10 h-10 bg-blue-600 text-white rounded-lg flex items-center justify-center font-bold text-sm shrink-0">MA</div>
          <div>
            <p class="text-sm font-bold text-slate-900">Malik Muhammad Ahsan Jahangir</p>
            <p class="text-xs text-slate-500 leading-tight mt-1">Lead Academic Author<br>BS (Hons) Microbiology & MPhil Biotechnology</p>
          </div>
        </div>
      </div>

      <!-- Column 2: The 7 Pillars (Takes up 4 columns) -->
      <div class="col-span-1 md:col-span-4">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">All Study Resources</h4>
        <ul class="grid grid-cols-2 gap-y-3 gap-x-4 text-sm text-slate-600">
          <li><Link href={`${import.meta.env.BASE_URL}/notes/`} class="hover:text-blue-600 transition-colors">Chapter Notes</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/past-papers/`} class="hover:text-blue-600 transition-colors">Past Papers</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/textbooks/`} class="hover:text-blue-600 transition-colors">Textbooks</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/pairing-schemes/`} class="hover:text-blue-600 transition-colors">Pairing Schemes</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/guess-papers/`} class="hover:text-blue-600 transition-colors">Guess Papers</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/date-sheets/`} class="hover:text-blue-600 transition-colors">Date Sheets</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/result-gazettes/`} class="hover:text-blue-600 transition-colors">Result Gazettes</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/authors/`} class="text-blue-600 font-semibold hover:underline">Our Expert Faculty</Link></li>
        </ul>
      </div>

      <!-- Column 3: Boards (Takes up 2 columns) -->
      <div class="col-span-1 md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Top Boards</h4>
        <ul class="space-y-3 text-sm text-slate-600">
          <li><Link href={`${import.meta.env.BASE_URL}/boards/punjab-board/`} class="hover:text-blue-600 transition-colors">Punjab Board</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/boards/sindh-board/`} class="hover:text-blue-600 transition-colors">Sindh Board</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/boards/fbise/`} class="hover:text-blue-600 transition-colors">Federal Board</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/boards/kpk-board/`} class="hover:text-blue-600 transition-colors">KPK Board</Link></li>
        </ul>
      </div>

      <!-- Column 4: Company & Trust (Takes up 2 columns) -->
      <div class="col-span-1 md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Company</h4>
        <ul class="space-y-3 text-sm text-slate-600">
          <li><Link href={`${import.meta.env.BASE_URL}/about/`} class="hover:text-blue-600 transition-colors">About Us</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/editorial-policy/`} class="hover:text-blue-600">Editorial Policy</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/contact/`} class="hover:text-blue-600 transition-colors">Contact</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/privacy-policy/`} class="hover:text-blue-600 transition-colors">Privacy Policy</Link></li>
          <li><Link href={`${import.meta.env.BASE_URL}/terms-of-service/`} class="hover:text-blue-600 transition-colors">Terms of Service</Link></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar (Copyright & Global Author Credit) -->
    <div class="pt-8 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <p>&copy; 2027 TaleemMarkaz. All rights reserved.</p>
      <p class="flex items-center gap-1">
        Verified by 
        <Link href={`${import.meta.env.BASE_URL}/authors/`} class="text-slate-900 font-semibold hover:text-blue-600 transition-colors">
          Malik Muhammad Ahsan Jahangir
        </Link> 
        <span class="mx-1 text-slate-300">|</span> 
        MPhil Biotechnology
      </p>
    </div>
  </div>
</footer>