---
import Layout from '../../layouts/Layout.astro';
import TuitionAd from '../../components/TuitionAd.astro';
import Math from '../../components/Math.astro';

const pageUrl = "https://taleemmarkaz.com/pairing-schemes/class-10-chemistry/";

const faqs = [
  { q: "How many marks is the Class 10 Chemistry paper in 2027?", a: "The textbook pairing instructions specify a total of 60 marks for the Chemistry paper." },
  { q: "How many MCQs are included in the 10th Class Chemistry paper?", a: "The objective section contains 12 MCQs, carrying one mark each." },
  { q: "How many short questions do students have to attempt?", a: "Students attempt five out of eight short questions in each of Q-2, Q-3 and Q-4. This means 15 short questions in total." },
  { q: "How many marks does each short question carry?", a: "Each attempted short question carries 2 marks." },
  { q: "How many long questions are included in the Chemistry paper?", a: "There are three detailed questions. Students must attempt any two, with each question carrying 9 marks." },
  { q: "Is Chapter 25 included in the Chemistry pairing scheme?", a: "Yes. Chapter 25 (Biochemistry) is included in the Q-4 short-question group and the Q-7 long-question combination. However, it is not listed in the objective MCQ table." },
  { q: "What is the duration of the Class 10 Chemistry examination?", a: "The textbook pairing instructions specify a duration of 2 hours." }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Class 10 Chemistry Pairing Scheme 2027 Punjab Boards – PECTAA",
      "description": "Check the Class 10 Chemistry Pairing Scheme 2027 for Punjab Boards. Get the complete chapter-wise MCQs, short questions, long questions and 60-mark paper pattern.",
      "author": {
        "@type": "Person",
        "name": "Ms. Sobiya Kanwal",
        "jobTitle": "Chemistry Specialist",
        "alumniOf": "Quaid-i-Azam University",
        "url": "https://taleemmarkaz.com/authors/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "TaleemMarkaz",
        "logo": { "@type": "ImageObject", "url": "https://taleemmarkaz.com/logo.png" }
      },
      "datePublished": "2026-11-08",
      "dateModified": "2026-11-08"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://taleemmarkaz.com/"},
        {"@type": "ListItem", "position": 2, "name": "Pairing Schemes", "item": "https://taleemmarkaz.com/pairing-schemes/"},
        {"@type": "ListItem", "position": 3, "name": "Class 10 Chemistry", "item": pageUrl}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<Layout 
  title="Class 10 Chemistry Pairing Scheme 2027 Punjab Boards – PECTAA"
  description="Check the Class 10 Chemistry Pairing Scheme 2027 for Punjab Boards. Get the complete chapter-wise MCQs, short questions, long questions and 60-mark paper pattern."
  canonical={pageUrl}
  schema={schema}
>
  <style is:global>
    /* PREVENT HORIZONTAL SCROLL */
    html, body { overflow-x: hidden; }

    /* URDU SPACING */
    .font-urdu { font-family: 'Gulzar', serif; line-height: 3.2; font-size: 1.15rem; }
    .font-urdu li { margin-bottom: 0.5rem; }

    /* KATEX OVERFLOW FIX */
    .katex-display { overflow-x: auto; overflow-y: hidden; max-width: 100%; padding-bottom: 4px; }
    .katex { font-size: 1.1em; }
    
    /* TABLE CONTAINMENT */
    table { table-layout: auto; width: 100%; }
    td, th { vertical-align: middle !important; }

    @media print {
      header, footer, nav, .no-print, .breadcrumbs, .author-card { display: none !important; }
      body { background: white !important; color: black !important; font-size: 12pt; overflow-x: visible; }
      main { padding: 0 !important; margin: 0 !important; }
      .max-w-4xl { max-width: 100% !important; }
      .print-header { display: flex !important; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 10px; margin-bottom: 20px; }
      .print-header h1 { font-size: 16pt; margin: 0; color: #0f172a; }
      table { page-break-inside: avoid; }
      tr { page-break-inside: avoid; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      .font-urdu { font-size: 14pt; line-height: 2.8; }
    }
    .print-header { display: none; }
  </style>

  <div class="bg-slate-100 border-b border-slate-200 py-3 px-4 breadcrumbs no-print w-full overflow-hidden">
    <div class="max-w-5xl mx-auto text-sm text-slate-500 flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-blue-600">Home</a> <span>/</span>
      <a href="/pairing-schemes/" class="hover:text-blue-600">Pairing Schemes</a> <span>/</span>
      <span class="text-slate-900 font-medium">Class 10 Chemistry</span>
    </div>
  </div>

  <section class="bg-white pt-12 pb-8 px-4 border-b border-slate-200 w-full overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <div class="print-header">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-emerald-600 text-white rounded flex items-center justify-center font-bold text-lg">T</div>
          <span class="text-xl font-extrabold text-slate-900">TaleemMarkaz</span>
        </div>
        <span class="text-sm font-semibold text-slate-500">taleemmarkaz.com</span>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold uppercase tracking-wider mb-4 no-print">
        🚨 Official Government Update
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Class 10 Chemistry Pairing Scheme 2027 <span class="text-emerald-600">(Punjab Boards)</span>
      </h1>
      <p class="text-lg text-slate-600 mb-6 max-w-3xl">
        Students preparing for the Class 10 Chemistry examination 2027 can use this chapter-wise pairing scheme to understand the distribution of MCQs, short questions and long questions. 
      </p>

      <button onclick="window.print()" class="no-print bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-6 rounded-lg transition-colors inline-flex items-center gap-2 shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download PDF with Logo
      </button>

      <div class="author-card bg-white border border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm mt-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-emerald-600 text-white rounded-full flex items-center justify-center font-bold text-xl md:text-2xl shrink-0 border-4 border-emerald-100">SK</div>
            <div class="text-left">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Academically Reviewed By</p>
              </div>
              <a href="/authors/" class="text-lg md:text-xl font-extrabold text-slate-900 hover:text-emerald-600 transition-colors leading-tight block">Ms. Sobiya Kanwal</a>
              <p class="text-sm font-medium text-slate-600 mt-0.5">Chemistry Specialist | M.Phil Chemistry</p>
            </div>
          </div>
          <div class="flex flex-row md:flex-col lg:flex-row gap-6 md:gap-2 lg:gap-6 text-sm text-slate-500 md:border-l md:border-slate-200 md:pl-6 pt-4 md:pt-0 border-t md:border-t-0 border-slate-200">
            <div><span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Published</span><span class="font-semibold text-slate-700">Nov 8, 2026</span></div>
            <div><span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Updated</span><span class="font-semibold text-slate-700">Nov 8, 2026</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12 w-full overflow-hidden">
    <div class="prose prose-slate prose-lg max-w-none text-slate-700">
      
      <div class="bg-blue-50 border-l-4 border-blue-600 p-6 rounded-r-xl mb-10 not-prose">
        <h3 class="text-xl font-bold text-blue-900 mb-3 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Official Announcement by Punjab Education Minister
        </h3>
        <p class="text-blue-800 mb-4"><strong>This is the official 2027 Chemistry paper pattern for all Punjab Boards.</strong></p>
        <p class="text-blue-800 mb-4">Punjab Education Minister <strong>Rana Sikandar Hayat</strong> has officially authorized the inclusion of pairing schemes directly into the 2027 PCTB curriculum textbooks for Class 9 and Class 10.</p>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 my-8 not-prose" dir="rtl">
        <h3 class="text-2xl font-bold text-slate-900 mb-4 font-urdu">اہم امتحانی ہدایات</h3>
        <ul class="space-y-4 text-slate-700 font-urdu">
          <li>• اس پیپر میں کل 60 نمبر ہیں جن میں 12 نمبر معروضی (MCQs) اور 48 نمبر سوالیہ (Subjective) ہیں۔</li>
          <li>• پیپر کا وقت 2 گھنٹے ہوگا۔ معروضی حصے کے لیے 15 منٹ اور سوالیہ حصے کے لیے 1 گھنٹہ 45 منٹ ہوں گے۔</li>
          <li>• سوالیہ حصے میں Q.2, Q.3 اور Q.4 شامل ہیں، ہر سوال میں 8 میں سے 5 سوالات حل کرنے ہوں گے۔</li>
          <li>• طویل سوالات میں Q.5 تا Q.7 میں سے 2 سوال حل کرنے ہوں گے۔ ہر سوال کے دو حصے (a) اور (b) ہوں گے۔</li>
        </ul>
      </div>

      <p>The scheme reproduced below is based on the pairing instructions printed on page 162 of the Chemistry-X textbook provided for reference.</p>
      <p>The Chemistry paper carries 60 marks and has a total time duration of 2 hours. It consists of 12 MCQs, three groups of short questions and three detailed questions, from which students must attempt two.</p>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Class 10 Chemistry Paper Pattern 2027</h2>
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900">Paper Section</th>
              <th class="p-3 font-bold text-slate-900">Questions to Attempt</th>
              <th class="p-3 font-bold text-slate-900 text-center">Marks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Objective (Q-1)</td><td class="p-3">12 MCQs</td><td class="p-3 text-center text-emerald-600 font-bold">12</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Short Questions (Q-2)</td><td class="p-3">5 out of 8</td><td class="p-3 text-center">10</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Short Questions (Q-3)</td><td class="p-3">5 out of 8</td><td class="p-3 text-center">10</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Short Questions (Q-4)</td><td class="p-3">5 out of 8</td><td class="p-3 text-center">10</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Long Questions (Q-5 to Q-7)</td><td class="p-3">Any 2 out of 3</td><td class="p-3 text-center">18</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Total Marks</td><td class="p-3"></td><td class="p-3 text-center text-emerald-600">60</td></tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Class 10 Chemistry MCQs Pairing Scheme 2027</h2>
      <p>The objective section contains 12 multiple-choice questions. According to the textbook table, one MCQ is allocated to each of the following 12 chapters.</p>
      
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900">Chapter No.</th>
              <th class="p-3 font-bold text-slate-900">Chapter Name</th>
              <th class="p-3 font-bold text-slate-900 text-center">Number of MCQs</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3">14</td><td class="p-3">States of Matter and Phase Changes</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">15</td><td class="p-3">Stoichiometry</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">16</td><td class="p-3">Electrochemistry</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">17</td><td class="p-3">Reaction Kinetics</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">18</td><td class="p-3">Salts</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">19</td><td class="p-3">Nitrogen and Sulphur</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">20</td><td class="p-3">Water</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">21</td><td class="p-3">Organic Chemistry</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">22</td><td class="p-3">Hydrocarbons</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">23</td><td class="p-3">Monohydroxy Alkanes or Alcohols</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">24</td><td class="p-3">Carboxylic Acids</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">26</td><td class="p-3">Polymers</td><td class="p-3 text-center font-bold text-emerald-600">1</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm bg-emerald-50 text-emerald-900 p-4 rounded-lg border border-emerald-200"><strong>Important:</strong> Chapter 25 (Biochemistry) is not included in the MCQ distribution shown in the textbook table. Do not confuse its inclusion in the subjective section with the objective section.</p>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">10th Class Chemistry Short Questions Pairing Scheme 2027</h2>
      <p>The subjective short-question section carries 30 marks. It is divided into three questions: Q-2, Q-3 and Q-4. Students must attempt 5 questions out of 8 in each group. Each attempted short question carries 2 marks.</p>

      <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">Q-2: Short Questions from Chapters 14 to 18</h3>
      <div class="overflow-x-auto w-full max-w-full my-4 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead><tr class="bg-slate-100 border-b border-slate-200"><th class="p-3 font-bold text-slate-900">Chapter</th><th class="p-3 font-bold text-slate-900 text-center">Number of Short Questions</th></tr></thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 14</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 15</td><td class="p-3 text-center">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 16</td><td class="p-3 text-center">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 17</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 18</td><td class="p-3 text-center">2</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Total</td><td class="p-3 text-center text-emerald-600">8</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm font-bold text-slate-700 mb-6">Marks: 5 × 2 = 10</p>

      <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">Q-3: Short Questions from Chapters 19 to 22</h3>
      <div class="overflow-x-auto w-full max-w-full my-4 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead><tr class="bg-slate-100 border-b border-slate-200"><th class="p-3 font-bold text-slate-900">Chapter</th><th class="p-3 font-bold text-slate-900 text-center">Number of Short Questions</th></tr></thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 19</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 20</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 21</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 22</td><td class="p-3 text-center">2</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Total</td><td class="p-3 text-center text-emerald-600">8</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm font-bold text-slate-700 mb-6">Marks: 5 × 2 = 10</p>

      <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">Q-4: Short Questions from Chapters 23 to 26</h3>
      <div class="overflow-x-auto w-full max-w-full my-4 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead><tr class="bg-slate-100 border-b border-slate-200"><th class="p-3 font-bold text-slate-900">Chapter</th><th class="p-3 font-bold text-slate-900 text-center">Number of Short Questions</th></tr></thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 23</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 24</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 25</td><td class="p-3 text-center">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3">Chapter 26</td><td class="p-3 text-center">2</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Total</td><td class="p-3 text-center text-emerald-600">8</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm font-bold text-slate-700 mb-6">Marks: 5 × 2 = 10</p>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Class 10 Chemistry Long Questions Pairing Scheme 2027</h2>
      <p>The long-question section contains three detailed questions: Q-5, Q-6 and Q-7. Each question is divided into two parts: Part (a) of 5 marks and Part (b) of 4 marks. Students must attempt any two questions out of the three.</p>
      
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900">Question</th>
              <th class="p-3 font-bold text-slate-900">Part (a) – 5 Marks</th>
              <th class="p-3 font-bold text-slate-900">Part (b) – 4 Marks</th>
              <th class="p-3 font-bold text-slate-900 text-center">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q-5</td><td class="p-3">Chapter 14</td><td class="p-3">Chapter 15</td><td class="p-3 text-center font-bold text-emerald-600">9</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q-6</td><td class="p-3">Chapter 20</td><td class="p-3">Chapter 22</td><td class="p-3 text-center font-bold text-emerald-600">9</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q-7</td><td class="p-3">Chapter 23</td><td class="p-3">Chapter 25</td><td class="p-3 text-center font-bold text-emerald-600">9</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm font-bold text-slate-700 mb-6">Total long-question marks: 2 × 9 = 18 marks.</p>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Important Preparation Tips for Class 10 Chemistry 2027</h2>
      <ul class="list-disc pl-5 space-y-2">
