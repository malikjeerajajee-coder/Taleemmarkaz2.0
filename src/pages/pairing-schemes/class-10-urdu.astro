---
import Layout from '../../layouts/Layout.astro';
import TuitionAd from '../../components/TuitionAd.astro';
import AuthorBox from '../../components/AuthorBox.astro';

const pageUrl = "https://taleemmarkaz.com/pairing-schemes/class-10-urdu/";

const faqs = [
  { q: "What is the total marks of Class 10 Urdu paper 2027?", a: "The Urdu paper carries 75 marks in total, divided into 15 marks for the Objective section and 60 marks for the Subjective section." },
  { q: "How much time is allowed for the Urdu paper?", a: "The total time allowed is 2 hours and 30 minutes. The objective part is usually allotted 20 minutes, while the subjective part gets 2 hours and 10 minutes." },
  { q: "How many MCQs are included in the 10th Class Urdu paper?", a: "There are 15 MCQs in total. They cover Prose (7), Nazm (2), Ghazal (1), Vocabulary (1), Pronunciation (1), Rhetorical Devices (1), and Grammar (2)." },
  { q: "How many questions are in the subjective section?", a: "There are 6 subjective questions (Q.2 to Q.7). They include Tashreeh (poetry explanation), Nasri Iqtibas (prose explanation), Short Questions, Khulasa (summary), Mazmoon (essay), and Tafheem (comprehension)." }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Class 10 Urdu Pairing Scheme 2027 Punjab Board – Official Paper Pattern & Model Paper",
      "description": "Get the official Class 10 Urdu Pairing Scheme 2027 for Punjab Boards. Check the 75-mark paper pattern, chapter-wise distribution, grammar, and complete Urdu model paper.",
      "author": {
        "@type": "Person",
        "name": "Ms. Ayesha Rehman",
        "jobTitle": "Urdu Specialist",
        "alumniOf": "Quaid-i-Azam University",
        "url": "https://taleemmarkaz.com/authors/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "TaleemMarkaz",
        "logo": { "@type": "ImageObject", "url": "https://taleemmarkaz.com/logo.png" }
      },
      "datePublished": "2026-11-08",
      "dateModified": "2026-11-13"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://taleemmarkaz.com/"},
        {"@type": "ListItem", "position": 2, "name": "Pairing Schemes", "item": "https://taleemmarkaz.com/pairing-schemes/"},
        {"@type": "ListItem", "position": 3, "name": "Class 10 Urdu", "item": pageUrl}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<Layout 
  title="Class 10 Urdu Pairing Scheme 2027 Punjab Board – Official Pattern"
  description="Get the official Class 10 Urdu Pairing Scheme 2027 for Punjab Boards. Check the 75-mark paper pattern, chapter-wise distribution, grammar, and complete Urdu model paper."
  canonical={pageUrl}
  schema={schema}
>
  <style is:global>
    html, body { overflow-x: hidden; }
    /* Specific class for Urdu text blocks only */
    .font-urdu { font-family: 'Gulzar', serif; line-height: 2.4; font-size: 1.15rem; }
    .font-urdu li { margin-bottom: 0.5rem; }
    table { table-layout: auto; width: 100%; }
    td, th { vertical-align: middle !important; }

    @media print {
      header, footer, nav, .no-print, .breadcrumbs, .author-card { display: none !important; }
      body { background: white !important; color: black !important; font-size: 12pt; overflow-x: visible; }
      main { padding: 0 !important; margin: 0 !important; }
      .max-w-4xl { max-width: 100% !important; }
      .print-header { display: flex !important; align-items: center; justify-content: space-between; border-bottom: 2px solid #4338ca; padding-bottom: 10px; margin-bottom: 20px; }
      .print-header h1 { font-size: 16pt; margin: 0; color: #0f172a; }
      table { page-break-inside: avoid; }
      tr { page-break-inside: avoid; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      .font-urdu { font-size: 14pt; line-height: 2.2; }
    }
    .print-header { display: none; }
  </style>

  <div class="bg-slate-100 border-b border-slate-200 py-3 px-4 breadcrumbs no-print w-full overflow-hidden">
    <div class="max-w-5xl mx-auto text-sm text-slate-500 flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-indigo-600">Home</a> <span>/</span>
      <a href="/pairing-schemes/" class="hover:text-indigo-600">Pairing Schemes</a> <span>/</span>
      <span class="text-slate-900 font-medium">Class 10 Urdu</span>
    </div>
  </div>

  <section class="bg-white pt-12 pb-8 px-4 border-b border-slate-200 w-full overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <div class="print-header">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-indigo-600 text-white rounded flex items-center justify-center font-bold text-lg">T</div>
          <span class="text-xl font-extrabold text-slate-900">TaleemMarkaz</span>
        </div>
        <span class="text-sm font-semibold text-slate-500">taleemmarkaz.com</span>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold uppercase tracking-wider mb-4 no-print">
        🚨 Official 2027 Guide
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Class 10 Urdu Pairing Scheme 2027 <span class="text-indigo-600">(Punjab Board)</span>
      </h1>
      <p class="text-lg text-slate-600 mb-6 max-w-3xl">
        Below is the official paper pattern, pairing scheme, and a complete model paper for Class 10 Urdu under the Punjab Boards (PECTAA / Single National Curriculum guidelines).
      </p>

      <button onclick="window.print()" class="no-print bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-lg transition-colors inline-flex items-center gap-2 shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download PDF with Logo
      </button>

      <div class="mt-8">
        <AuthorBox 
          name="Ms. Ayesha Rehman"
          role="Urdu Specialist"
          qualifications="BS Urdu Language"
          university="Quaid-i-Azam University"
          initials="AR"
          theme="purple"
          publishedDate="Nov 8, 2026"
        />
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12 w-full overflow-hidden">
    <div class="prose prose-slate prose-lg max-w-none text-slate-700">
      
      <!-- ALERT BOX -->
      <div class="bg-indigo-50 border-l-4 border-indigo-600 p-6 rounded-r-xl mb-10 not-prose">
        <h3 class="text-xl font-bold text-indigo-900 mb-3 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Exam Overview
        </h3>
        <ul class="text-indigo-900 space-y-2 font-medium">
          <li>• <strong>Total Marks:</strong> 75 (Objective: 15 | Subjective: 60)</li>
          <li>• <strong>Total Time:</strong> 2 Hours 30 Minutes</li>
          <li>• <strong>Applicable Boards:</strong> All 9 BISE Punjab Boards (Lahore, Rawalpindi, Gujranwala, Multan, Faisalabad, Sargodha, Bahawalpur, Sahiwal, DG Khan).</li>
        </ul>
      </div>

      <!-- OBJECTIVE SECTION -->
      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Part I: Objective Section (15 Marks)</h2>
      <p class="mb-4">Question No. 1 consists of 15 Multiple Choice Questions (1 mark each).</p>
      
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900">Section (حصہ)</th>
              <th class="p-3 font-bold text-slate-900">Syllabus Source</th>
              <th class="p-3 font-bold text-slate-900 text-center">MCQs</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900" dir="rtl">نثر (Prose)</td><td class="p-3">1 MCQ per lesson from the 10 textbook prose lessons</td><td class="p-3 text-center font-bold text-indigo-600">7</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900" dir="rtl">نظم (Nazm)</td><td class="p-3">From textbook poems (Aadmi Nama, Namood-e-Subh, Khitab ba Jawanan-e-Islam, etc.)</td><td class="p-3 text-center font-bold text-indigo-600">2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900" dir="rtl">غزل (Ghazal)</td><td class="p-3">From textbook ghazals (Ghalib, Momin, Hasrat Mohani, Zehra Nigah)</td><td class="p-3 text-center font-bold text-indigo-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900" dir="rtl">مترادف / دو معنی الفاظ</td><td class="p-3">Textbook Exercises & Vocabulary</td><td class="p-3 text-center font-bold text-indigo-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900" dir="rtl">تلفظ و اعراب</td><td class="p-3">Correct pronunciation and diacritics</td><td class="p-3 text-center font-bold text-indigo-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900" dir="rtl">تشبیہ و استعارہ</td><td class="p-3">Literary terms and rhetorical devices</td><td class="p-3 text-center font-bold text-indigo-600">1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900" dir="rtl">صرف و نحو</td><td class="p-3">Basic grammar concepts from textbook exercises</td><td class="p-3 text-center font-bold text-indigo-600">2</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3" dir="rtl">کل</td><td class="p-3"></td><td class="p-3 text-center text-indigo-600">15</td></tr>
          </tbody>
        </table>
      </div>

      <!-- SUBJECTIVE SECTION -->
      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Part II: Subjective Section (60 Marks)</h2>
      
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900 text-center w-12">Q. No</th>
              <th class="p-3 font-bold text-slate-900">Question Type</th>
              <th class="p-3 font-bold text-slate-900">Details & Choice Breakdown</th>
              <th class="p-3 font-bold text-slate-900 text-center">Marks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900 text-center">2</td>
              <td class="p-3 font-bold" dir="rtl">اشعار کی تشریح</td>
              <td class="p-3">Nazm: 3 out of 4 (2x3=6) <br> Ghazal: 2 out of 3 (2x2=4)</td>
              <td class="p-3 text-center font-bold text-indigo-600">10</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900 text-center">3</td>
              <td class="p-3 font-bold" dir="rtl">نثری اقتباسات کی تشریح</td>
              <td class="p-3">2 Passages (1 from first 5 lessons, 1 from last 5) with reference (5+5)</td>
              <td class="p-3 text-center font-bold text-indigo-600">10</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900 text-center">4</td>
              <td class="p-3 font-bold" dir="rtl">مختصر سوالات</td>
              <td class="p-3">5 out of 8 (Prose 4, Nazm 2, Ghazal 2)</td>
              <td class="p-3 text-center font-bold text-indigo-600">10</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900 text-center">5</td>
              <td class="p-3 font-bold" dir="rtl">سبق کا خلاصہ</td>
              <td class="p-3">1 out of 2 given lessons</td>
              <td class="p-3 text-center font-bold text-indigo-600">5</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900 text-center">6</td>
              <td class="p-3 font-bold" dir="rtl">مضمون نویسی</td>
              <td class="p-3">1 detailed essay out of 3 topics</td>
              <td class="p-3 text-center font-bold text-indigo-600">15</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900 text-center">7</td>
              <td class="p-3 font-bold" dir="rtl">تفہیمِ عبارت</td>
              <td class="p-3">1 paragraph with 5 questions (2 marks each)</td>
              <td class="p-3 text-center font-bold text-indigo-600">10</td>
            </tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3"></td><td class="p-3">Total</td><td class="p-3"></td><td class="p-3 text-center text-indigo-600">60</td></tr>
          </tbody>
        </table>
      </div>

      <!-- MODEL PAPER -->
      <h2 class="text-2xl font-extrabold text-slate-900 mt-12 mb-4 border-b border-slate-200 pb-2">Class 10 Urdu Model Paper 2027</h2>
      
      <!-- Objective Model Paper -->
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden not-prose my-6">
        <div class="bg-slate-100 p-4 border-b border-slate-200 flex justify-between items-center">
          <h3 class="text-lg font-bold text-slate-900">Objective Type</h3>
          <span class="text-sm font-semibold text-slate-600">Marks: 15 | Time: 20 Min</span>
        </div>
        <div class="p-6">
          <p class="text-sm font-bold text-slate-800 mb-4">Q.1: Choose the correct answer. (1x15 = 15)</p>
          
          <!-- Urdu MCQs Block -->
          <div class="font-urdu text-lg" dir="rtl">
            <ol class="list-decimal pr-6 space-y-4 text-slate-800">
              <li>سبق "اخلاقِ نبوی ﷺ" کس مصنف کی تحریر ہے؟ <br> <span class="text-slate-600 text-base">(الف) مولانا الطاف حسین حالی (ب) شبلی نعمانی (ج) اشفاق احمد (د) میرزا ادیب</span></li>
              <li>سرسید احمد خان کا بچپن کس شہر میں گزرا؟ <br> <span class="text-slate-600 text-base">(الف) علی گڑھ (ب) آگرہ (ج) دہلی (د) لکھنؤ</span></li>
              <li>افسانہ "کفّارہ" کس کی تخلیق ہے؟ <br> <span class="text-slate-600 text-base">(الف) منشی پریم چند (ب) پطرس بخاری (ج) شفیع عقیل (د) غلام الثقلین نقوی</span></li>
              <li>مضمون "سویرے جو کل آنکھ میری کھلی" میں مصنف کو کس امتحان کی فکر لاحق تھی؟ <br> <span class="text-slate-600 text-base">(الف) ایف اے (ب) بی اے (ج) ایم اے (د) میٹرک</span></li>
              <li>"بابل کے کھنڈر" کس صنفِ ادب سے تعلق رکھتا ہے؟ <br> <span class="text-slate-600 text-base">(الف) افسانہ (ب) سفرنامہ (ج) خاکہ (د) ڈراما</span></li>
              <li>"اولڈ ایج ہوم" کے مصنف کون ہیں؟ <br> <span class="text-slate-600 text-base">(الف) ڈاکٹر ابو اللیث صدیقی (ب) جمیل الدین عالی (ج) میرزا ادیب (د) اشفاق احمد</span></li>
              <li>سبق "کچھ ذریعۂ تعلیم کے باب میں" کے مصنف کا نام کیا ہے؟ <br> <span class="text-slate-600 text-base">(الف) ڈاکٹر ابو اللیث صدیقی (ب) شبلی نعمانی (ج) الطاف حسین حالی (د) پطرس بخاری</span></li>
              <li>نظم "آدمی نامہ" کس شاعر کی تخلیق ہے؟ <br> <span class="text-slate-600 text-base">(الف) علامہ محمد اقبال (ب) نظیر اکبر آبادی (ج) میر انیس (د) انور مسعود</span></li>
              <li>نظم "نمودِ صبح" کس صنفِ سخن میں لکھی گئی ہے؟ <br> <span class="text-slate-600 text-base">(الف) مسدس (ب) مثنوی (ج) مرثیہ / سلام (د) قطعہ</span></li>
              <li>غزل "بازیچۂ اطفال ہے دنیا میرے آگے" کس شاعر کا کلام ہے؟ <br> <span class="text-slate-600 text-base">(الف) مومن خاں مومن (ب) مرزا غالب (ج) حسرت موہانی (د) زہرا نگاه</span></li>
              <li>لفظ "عالم" کے دو درست معانی کون سے ہیں؟ <br> <span class="text-slate-600 text-base">(الف) دنیا اور جاننے والا (ب) علم اور کتاب (ج) استاد اور شاگرد (د) آسمان اور زمین</span></li>
              <li>درست اعراب والا لفظ منتخب کریں: <br> <span class="text-slate-600 text-base">(الف) مُحَسِّن (ب) مُحْسِن (ج) مَحْسَن (د) مِحْسِن</span></li>
              <li>"میرا بیٹا شیر کی طرح بہادر ہے" — قواعد کی رو سے یہ جملہ کس کی مثال ہے؟ <br> <span class="text-slate-600 text-base">(الف) استعارہ (ب) تشبیہ (ج) تلمیح (د) مجازِ مرسل</span></li>
              <li>وہ اسم جو کسی خاص شخص، جگہ یا چیز کا نام ہو، کہلاتا ہے: <br> <span class="text-slate-600 text-base">(الف) اسمِ نکرہ (ب) اسمِ معرفہ (ج) اسمِ ضمیر (د) اسمِ صفت</span></li>
              <li>جملہ "احمد نے خط لکھا" میں "لکھا" قواعد کی رو سے کیا ہے؟ <br> <span class="text-slate-600 text-base">(الف) فاعل (ب) مفعول (ج) فعل (د) حرف</span></li>
            </ol>
          </div>
        </div>
      </div>

      <!-- Subjective Model Paper -->
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden not-prose my-6">
        <div class="bg-slate-100 p-4 border-b border-slate-200 flex justify-between items-center">
          <h3 class="text-lg font-bold text-slate-900">Subjective Type</h3>
          <span class="text-sm font-semibold text-slate-600">Marks: 60 | Time: 2 Hrs 10 Min</span>
        </div>
        <div class="p-6 space-y-8">
          
          <div>
            <h4 class="font-bold text-slate-900 mb-3 text-lg border-b border-slate-100 pb-1">Q.2: Explain the following verses (Tashreeh). Write the poet's name and poem title. (10 Marks)</h4>
            <div class="font-urdu text-lg text-slate-800" dir="rtl">
              <p class="font-bold mb-2 font-sans text-sm text-slate-600">(A) Nazm Section (Attempt 3 out of 4):</p>
              <ul class="list-disc pr-6 space-y-2 mb-4">
                <li>دنیا میں بادشاہ ہے سو ہے وہ بھی آدمی / اور مفلس و گدا ہے سو ہے وہ بھی آدمی</li>
                <li>کبھی اے نوجواں مسلم! تدبّر بھی کیا تو نے / وہ کیا گردوں تھا تو جس کا ہے اک ٹوٹا ہوا تارا</li>
                <li>تجھے اس قوم نے پالا ہے آغوشِ محبت میں / کچل ڈالا تھا جس نے پاؤں میں تاجِ سرِ دارا</li>
                <li>آمدِ صبح کی خبر لائی نسیمِ سحری / کھل گئے غنچے، چمن میں ہوئی تازہ نظری</li>
              </ul>
              <p class="font-bold mb-2 font-sans text-sm text-slate-600">(B) Ghazal Section (Attempt 2 out of 3):</p>
              <ul class="list-disc pr-6 space-y-2">
                <li>بازیچۂ اطفال ہے دنیا میرے آگے / ہوتا ہے شب و روز تماشا میرے آگے</li>
                <li>تم مرے پاس ہوتے ہو گویا / جب کوئی دوسرا نہیں ہوتا</li>
                <li>ہے مشقِ سخن جاری، چکی کی مشقت بھی / اک طرفہ تماشا ہے حسرتؔ کی طبیعت بھی</li>
              </ul>
            </div>
          </div>

          <div>
