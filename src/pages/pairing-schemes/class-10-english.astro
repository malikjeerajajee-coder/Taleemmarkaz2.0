---
import AuthorBox from '../../components/AuthorBox.astro';

import Layout from '../../layouts/Layout.astro';
import TuitionAd from '../../components/TuitionAd.astro';

const pageUrl = "https://taleemmarkaz.com/pairing-schemes/class-10-english/";

const faqs = [
  { q: "What are the total marks of Class 10 English paper 2027?", a: "The English theory paper carries 75 marks, including 19 objective marks and 56 subjective marks." },
  { q: "How much time is allowed for the English paper?", a: "The published examination instructions specify 2 hours and 30 minutes, including 20 minutes for the objective portion and 2 hours and 10 minutes for the subjective portion." },
  { q: "How many MCQs are included in the English paper?", a: "There are 19 compulsory MCQs divided into four parts: verbs, spellings, meanings and grammar." },
  { q: "How many short questions are required in Q.2?", a: "Eight questions are provided, and students must attempt any five. Each question carries two marks." },
  { q: "How many marks are allocated to essay writing?", a: "Essay or paragraph writing carries 15 marks. Students should follow the word limit and choice given in the question." },
  { q: "How many questions are included in the translation section?", a: "Q.3 offers two paragraphs, from which students attempt one. Q.8 contains an Urdu-to-English paragraph or the prescribed alternative for eligible English-medium candidates." },
  { q: "Is the Class 10 English paper pattern the same for all Punjab Boards?", a: "Punjab Boards generally follow the common examination framework. Students should check their respective BISE notifications for any board-specific instructions or amendments." },
  { q: "Which textbook should students use for the 2027 examination?", a: "Students should follow the prescribed English 10 textbook for the 2026–27 academic session. PECTAA lists the English 10 (2026–27) textbook in its official curriculum resources." },
  { q: "Are important essay topics guaranteed to appear in the examination?", a: "No. Suggested essay topics are provided for practice. Students should prepare different topics and follow the actual choices in the examination paper." },
  { q: "Can students prepare English using only the pairing scheme?", a: "No. A pairing scheme helps students understand question distribution, but it cannot replace the prescribed textbook, grammar exercises and writing practice." },
  { q: "What is the best way to improve English translation?", a: "Practise short passages daily, improve vocabulary, understand tenses and sentence structure, and check your mistakes after every exercise." },
  { q: "Where can I check the official Class 10 English syllabus?", a: "Students can visit the PECTAA website and open its Curriculum and Compliance section to find the prescribed textbook and relevant curriculum resources." }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Class 10 English Pairing Scheme 2027 Punjab Board – Paper Pattern & Model Paper",
      "description": "Get the Class 10 English Pairing Scheme 2027 for Punjab Board. Check the 75-mark paper pattern, chapter-wise question distribution, MCQs, model paper, grammar preparation and exam tips.",
      "author": {
        "@type": "Person",
        "name": "Sir Ikhlaq Qureshi",
        "jobTitle": "English Specialist",
        "alumniOf": "University of the Punjab, Lahore",
        "url": "https://taleemmarkaz.com/authors/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "TaleemMarkaz",
        "logo": { "@type": "ImageObject", "url": "https://taleemmarkaz.com/logo.png" }
      },
      "datePublished": "2026-11-08",
      "dateModified": "2026-11-08"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://taleemmarkaz.com/"},
        {"@type": "ListItem", "position": 2, "name": "Pairing Schemes", "item": "https://taleemmarkaz.com/pairing-schemes/"},
        {"@type": "ListItem", "position": 3, "name": "Class 10 English", "item": pageUrl}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<Layout 
  title="Class 10 English Pairing Scheme 2027 Punjab Board – Paper Pattern & Model Paper"
  description="Get the Class 10 English Pairing Scheme 2027 for Punjab Board. Check the 75-mark paper pattern, chapter-wise question distribution, MCQs, model paper, grammar preparation and exam tips."
  canonical={pageUrl}
  schema={schema}
>
  <style is:global>
    html, body { overflow-x: hidden; }
    .font-urdu { font-family: 'Gulzar', serif; line-height: 3.2; font-size: 1.15rem; }
    .font-urdu li { margin-bottom: 0.5rem; }
    .katex-display { overflow-x: auto; overflow-y: hidden; max-width: 100%; padding-bottom: 4px; }
    .katex { font-size: 1.1em; }
    table { table-layout: auto; width: 100%; }
    td, th { vertical-align: middle !important; }

    @media print {
      header, footer, nav, .no-print, .breadcrumbs, .author-card { display: none !important; }
      body { background: white !important; color: black !important; font-size: 12pt; overflow-x: visible; }
      main { padding: 0 !important; margin: 0 !important; }
      .max-w-4xl { max-width: 100% !important; }
      .print-header { display: flex !important; align-items: center; justify-content: space-between; border-bottom: 2px solid #9333ea; padding-bottom: 10px; margin-bottom: 20px; }
      .print-header h1 { font-size: 16pt; margin: 0; color: #0f172a; }
      table { page-break-inside: avoid; }
      tr { page-break-inside: avoid; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      .font-urdu { font-size: 14pt; line-height: 2.8; }
    }
    .print-header { display: none; }
  </style>

  <div class="bg-slate-100 border-b border-slate-200 py-3 px-4 breadcrumbs no-print w-full overflow-hidden">
    <div class="max-w-5xl mx-auto text-sm text-slate-500 flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-blue-600">Home</a> <span>/</span>
      <a href="/pairing-schemes/" class="hover:text-blue-600">Pairing Schemes</a> <span>/</span>
      <span class="text-slate-900 font-medium">Class 10 English</span>
    </div>
  </div>

  <section class="bg-white pt-12 pb-8 px-4 border-b border-slate-200 w-full overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <div class="print-header">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-purple-600 text-white rounded flex items-center justify-center font-bold text-lg">T</div>
          <span class="text-xl font-extrabold text-slate-900">TaleemMarkaz</span>
        </div>
        <span class="text-sm font-semibold text-slate-500">taleemmarkaz.com</span>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 border border-purple-200 text-purple-700 text-xs font-bold uppercase tracking-wider mb-4 no-print">
        🚨 Updated for 2027 Session
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Class 10 English Pairing Scheme 2027 <span class="text-purple-600">(Punjab Board)</span>
      </h1>
      <p class="text-lg text-slate-600 mb-6 max-w-3xl">
        Are you looking for the Class 10 English Pairing Scheme 2027 for Punjab Board examinations? This guide explains the English paper pattern, question-wise marks distribution, textbook question groups, grammar sections, translation, essay writing and a complete practice model paper.
      </p>

      <button onclick="window.print()" class="no-print bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition-colors inline-flex items-center gap-2 shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download PDF with Logo
      </button>

      <AuthorBox 
      name="Sir Ikhlaq Qureshi"
      role="English Specialist"
      qualifications="BS English Literature"
      initials="IQ"
      theme="purple"
      publishedDate="Nov 8, 2026"
    />
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12 w-full overflow-hidden">
    <div class="prose prose-slate prose-lg max-w-none text-slate-700">
      
      <div class="bg-blue-50 border-l-4 border-blue-600 p-6 rounded-r-xl mb-10 not-prose">
        <h3 class="text-xl font-bold text-blue-900 mb-3 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Important Information
        </h3>
        <p class="text-blue-800 mb-2"><strong>This guide follows the available Class 10 English paper-setting instructions and the prescribed 2026–27 textbook reference.</strong></p>
        <p class="text-blue-800 text-sm">Any future official amendments should take priority over this preparation guide. The paper pattern and textbook are different things. Students should prepare from the prescribed 2026–27 textbook and use the question distribution below as a guide for practice.</p>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Quick Information: Class 10 English Pairing Scheme 2027</h2>
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900 w-1/3">Class</td><td class="p-3">10th / Matric Part-II</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Subject</td><td class="p-3">English Compulsory</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Academic Session</td><td class="p-3">2026–27</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Annual Examination</td><td class="p-3">2027</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Total Theory Marks</td><td class="p-3">75</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Objective Marks</td><td class="p-3">19</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Subjective Marks</td><td class="p-3">56</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Objective Time</td><td class="p-3">20 minutes</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Subjective Time</td><td class="p-3">2 hours 10 minutes</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Total Examination Time</td><td class="p-3">2 hours 30 minutes</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Boards</td><td class="p-3">Punjab BISE Boards</td></tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Class 10 English Paper Pattern 2027 – Punjab Board</h2>
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900">Question</th>
              <th class="p-3 font-bold text-slate-900">Subject</th>
              <th class="p-3 font-bold text-slate-900 text-center">Marks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.1</td><td class="p-3">Objective MCQs</td><td class="p-3 text-center text-purple-600 font-bold">19</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.2</td><td class="p-3">Short Questions</td><td class="p-3 text-center">10</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.3</td><td class="p-3">Translation / Simple English</td><td class="p-3 text-center">8</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.4</td><td class="p-3">Poem Summary / Stanza Explanation</td><td class="p-3 text-center">5</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.5</td><td class="p-3">Essay / Paragraph Writing</td><td class="p-3 text-center">15</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.6</td><td class="p-3">Direct and Indirect Speech</td><td class="p-3 text-center">5</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.7</td><td class="p-3">Pair of Words</td><td class="p-3 text-center">5</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.8</td><td class="p-3">Urdu to English Translation</td><td class="p-3 text-center">8</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Total</td><td class="p-3"></td><td class="p-3 text-center text-purple-600">75</td></tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Class 10 English Pairing Scheme 2027 – Question-Wise Details</h2>
      
      <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">Q.1 – Objective Type / MCQs (19 Marks)</h3>
      <div class="overflow-x-auto w-full max-w-full my-4 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead><tr class="bg-slate-100 border-b border-slate-200"><th class="p-3 font-bold text-slate-900">Part</th><th class="p-3 font-bold text-slate-900">Topic</th><th class="p-3 font-bold text-slate-900 text-center">Number of MCQs</th><th class="p-3 font-bold text-slate-900 text-center">Marks</th></tr></thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">A</td><td class="p-3">Correct Forms of Verbs</td><td class="p-3 text-center">5</td><td class="p-3 text-center">5</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">B</td><td class="p-3">Correct Spellings</td><td class="p-3 text-center">4</td><td class="p-3 text-center">4</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">C</td><td class="p-3">Meanings of Underlined Words</td><td class="p-3 text-center">5</td><td class="p-3 text-center">5</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">D</td><td class="p-3">Grammar-Based MCQs</td><td class="p-3 text-center">5</td><td class="p-3 text-center">5</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Total</td><td class="p-3"></td><td class="p-3 text-center">19</td><td class="p-3 text-center text-purple-600">19</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm mb-6"><strong>Preparation Tip:</strong> Do not prepare only selected chapters for MCQs. Revise vocabulary, spelling exercises and grammar from the complete prescribed syllabus.</p>

      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-2">Q.2 – Short Questions (10 Marks)</h3>
      <div class="overflow-x-auto w-full max-w-full my-4 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead><tr class="bg-slate-100 border-b border-slate-200"><th class="p-3 font-bold text-slate-900">Group</th><th class="p-3 font-bold text-slate-900">Textbook Coverage</th><th class="p-3 font-bold text-slate-900 text-center">Questions Provided</th></tr></thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Group A</td><td class="p-3">Units 1–5 + Review-I</td><td class="p-3 text-center font-bold">4</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Group B</td><td class="p-3">Units 6–10 + Review-II</td><td class="p-3 text-center font-bold">4</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Total</td><td class="p-3">Complete prescribed coverage</td><td class="p-3 text-center text-purple-600">8</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm mb-6">Students must attempt any <strong>5</strong> out of 8. Prepare short questions from both groups. Do not depend on a small list of guessed questions.</p>

      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-2">Q.3 – Translation into Urdu / Rewriting into Simple English (8 Marks)</h3>
      <div class="overflow-x-auto w-full max-w-full my-4 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead><tr class="bg-slate-100 border-b border-slate-200"><th class="p-3 font-bold text-slate-900">Paragraph</th><th class="p-3 font-bold text-slate-900">Prescribed Coverage</th></tr></thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Paragraph A</td><td class="p-3">Units 1, 3, 4 and 5</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Paragraph B</td><td class="p-3">Units 6, 8 and 10</td></tr>
            <tr class="bg-slate-50 font-bold"><td class="p-3">Attempt</td><td class="p-3 text-purple-600">Any 1 (8 Marks)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm mb-6">The question may require translation into Urdu or rewriting the given English passage in simple English, according to the examination instructions.</p>

      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-2">Q.4 – Summary of Poem OR Explanation of Stanza (5 Marks)</h3>
      <p class="text-sm mb-4">Students are required to attempt the given alternative: Write the summary of a poem OR explain a stanza with reference to context. The paper-setting instructions specify that the summary and stanza explanation are taken from different poems.</p>

      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-2">Q.5 – Essay Writing OR Paragraph Writing (15 Marks)</h3>
      <div class="overflow-x-auto w-full max-w-full my-4 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead><tr class="bg-slate-100 border-b border-slate-200"><th class="p-3 font-bold text-slate-900">Writing Type</th><th class="p-3 font-bold text-slate-900">Required Length</th><th class="p-3 font-bold text-slate-900 text-center">Marks</th></tr></thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Essay</td><td class="p-3">150–200 words</td><td class="p-3 text-center" rowspan="2">15</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Paragraph</td><td class="p-3">100–150 words</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-2">Q.6 – Direct and Indirect Speech (5 Marks)</h3>
      <p class="text-sm mb-4">Students must change any <strong>5 out of 8</strong> sentences from direct to indirect speech. Focus on Assertive, Interrogative, and Imperative sentences, along with changes in pronouns, tenses, and time expressions.</p>

      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-2">Q.7 – Pair of Words (5 Marks)</h3>
      <p class="text-sm mb-4">Students must use any <strong>5 out of 8</strong> given pairs of words in their own sentences. Write separate sentences that clearly demonstrate the meaning of each word.</p>

      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-2">Q.8 – Translation from Urdu into English (8 Marks)</h3>
      <p class="text-sm mb-4">Students are required to translate the given Urdu paragraph into English. For candidates whose examination medium is English, the alternative described in the paper-setting instructions is to write ten sentences on the given topic.</p>

      <!-- MODEL PAPER SECTION (ENGLISH ONLY) -->
      <h2 class="text-2xl font-extrabold text-slate-900 mt-12 mb-4 border-b border-slate-200 pb-2">Class 10 English Model Paper 2027 – Punjab Board</h2>
      <p class="text-sm text-slate-600 mb-6 italic">The following is an original practice model paper prepared for revision. It is not an official board-issued examination paper and does not contain guaranteed questions.</p>
      
      <!-- Objective Model Paper -->
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden not-prose my-6">
        <div class="bg-slate-100 p-4 border-b border-slate-200">
          <h3 class="text-lg font-bold text-slate-900">SECTION A – OBJECTIVE</h3>
          <p class="text-sm text-slate-600">Total Marks: 19 | Practice Time: 20 Minutes</p>
        </div>
        <div class="p-4 w-full overflow-hidden">
          <p class="text-sm font-bold text-slate-800 mb-4">Q.1: Choose the correct answer. (19 Marks)</p>
          
          <h4 class="font-bold text-slate-800 mb-2">Part A: Correct Form of Verbs (5 Marks)</h4>
          <ul class="text-sm text-slate-700 space-y-2 mb-6 list-decimal pl-5">
            <li>She ______ to school every day. <br> <span class="text-slate-500">(a) go (b) goes (c) going (d) gone</span></li>
            <li>They ______ football at the moment. <br> <span class="text-slate-500">(a) is playing (b) are playing (c) was playing (d) plays</span></li>
            <li>Ali ______ his homework yesterday. <br> <span class="text-slate-500">(a) complete (b) completes (c) completed (d) completing</span></li>
            <li>The sun ______ in the east. <br> <span class="text-slate-500">(a) rise (b) rises (c) rising (d) risen</span></li>
            <li>We ______ our examination next week. <br> <span class="text-slate-500">(a) take (b) took (c) will take (d) taking</span></li>
          </ul>

          <h4 class="font-bold text-slate-800 mb-2">Part B: Correct Spellings (4 Marks)</h4>
          <ul class="text-sm text-slate-700 space-y-2 mb-6 list-decimal pl-5">
            <li>Choose the correct spelling: <br> <span class="text-slate-500">(a) Enviroment (b) Environment (c) Envirnment (d) Enviornment</span></li>
            <li>Choose the correct spelling: <br> <span class="text-slate-500">(a) Knowlege (b) Knowledge (c) Knowlidge (d) Knowlege</span></li>
            <li>Choose the correct spelling: <br> <span class="text-slate-500">(a) Sucess (b) Success (c) Sucsess (d) Succes</span></li>
            <li>Choose the correct spelling: <br> <span class="text-slate-500">(a) Courage (b) Courag (c) Courge (d) Couraje</span></li>
          </ul>

          <h4 class="font-bold text-slate-800 mb-2">Part C: Correct Meanings (5 Marks)</h4>
          <ul class="text-sm text-slate-700 space-y-2 mb-6 list-decimal pl-5">
