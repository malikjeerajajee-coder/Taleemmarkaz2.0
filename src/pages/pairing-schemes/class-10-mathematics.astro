---
import Link from '../../components/Link.astro';

import Layout from '../../layouts/Layout.astro';
import TuitionAd from '../../components/TuitionAd.astro';
import Math from '../../components/Math.astro';

const pageUrl = "https://taleemmarkaz.com/pairing-schemes/class-10-mathematics/";

const faqs = [
  { q: "What is the total marks of the Class 10 Mathematics paper in 2027?", a: "The Class 10 Mathematics paper carries 75 marks. It includes 15 marks of MCQs, 36 marks of short questions and 24 marks of long questions." },
  { q: "How many MCQs are included in the 10th Class Maths paper?", a: "There are 15 MCQs in the objective portion. Chapters 9, 11 and 12 carry two MCQs each, while the remaining chapters carry one MCQ each." },
  { q: "How many short questions are included in the Mathematics pairing scheme?", a: "There are three short-question groups: Q.2, Q.3 and Q.4. Each group contains nine options, from which students attempt six. Each question carries two marks." },
  { q: "How many long questions are included in the Class 10 Maths paper?", a: "The paper contains five long questions (Q.5 to Q.9). Students attempt any two from Q.5-Q.7 and any one from Q.8-Q.9." },
  { q: "Which chapters carry two MCQs in Class 10 Mathematics 2027?", a: "Chapters 9 (Tangent and Angles of a Circle), 11 (Information Handling) and 12 (Probability) carry two MCQs each." },
  { q: "Can I prepare only the chapters mentioned in the long-question pairing?", a: "No. You should prepare the complete prescribed syllabus. Chapters can appear in different sections, and relying on selected long-question combinations may leave gaps in your preparation." },
  { q: "How can I score high marks in 10th Class Mathematics?", a: "Build a strong understanding of concepts, practise textbook exercises regularly, revise formulas, prepare MCQs and subjective questions, and solve complete practice papers." }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Class 10 Mathematics Pairing Scheme 2027 Punjab Board – Official PECTAA",
      "description": "Download the Class 10 Mathematics Pairing Scheme 2027 for Punjab Board. Check chapter-wise MCQs, short questions, long question combinations, paper marks and smart preparation tips.",
      "author": {
        "@type": "Person",
        "name": "Sir Naeem Khan",
        "jobTitle": "Mathematics Specialist",
        "alumniOf": "COMSATS University Islamabad",
        "url": "https://taleemmarkaz.com/authors/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "TaleemMarkaz",
        "logo": { "@type": "ImageObject", "url": "https://taleemmarkaz.com/logo.png" }
      },
      "datePublished": "2026-11-08",
      "dateModified": "2026-11-08"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://taleemmarkaz.com/"},
        {"@type": "ListItem", "position": 2, "name": "Pairing Schemes", "item": "https://taleemmarkaz.com/pairing-schemes/"},
        {"@type": "ListItem", "position": 3, "name": "Class 10 Mathematics", "item": pageUrl}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<Layout 
  title="Class 10 Mathematics Pairing Scheme 2027 Punjab Board – Official PECTAA"
  description="Download the Class 10 Mathematics Pairing Scheme 2027 for Punjab Board. Check chapter-wise MCQs, short questions, long question combinations, paper marks and smart preparation tips."
  canonical={pageUrl}
  schema={schema}
>
  <style is:global>
    /* 1. PREVENT PAGE HORIZONTAL SCROLL */
    html, body { overflow-x: hidden; }

    /* 2. URDU SPACING */
    .font-urdu { font-family: 'Gulzar', serif; line-height: 3.2; font-size: 1.15rem; }
    .font-urdu li { margin-bottom: 0.5rem; }

    /* 3. KATEX OVERFLOW FIX */
    .katex-display { overflow-x: auto; overflow-y: hidden; max-width: 100%; padding-bottom: 4px; }
    .katex { font-size: 1.1em; }
    
    /* 4. TABLE CONTAINMENT */
    table { table-layout: auto; width: 100%; }
    td, th { vertical-align: middle !important; }

    @media print {
      header, footer, nav, .no-print, .breadcrumbs, .author-card { display: none !important; }
      body { background: white !important; color: black !important; font-size: 12pt; overflow-x: visible; }
      main { padding: 0 !important; margin: 0 !important; }
      .max-w-4xl { max-width: 100% !important; }
      .print-header { display: flex !important; align-items: center; justify-content: space-between; border-bottom: 2px solid #ea580c; padding-bottom: 10px; margin-bottom: 20px; }
      .print-header h1 { font-size: 16pt; margin: 0; color: #0f172a; }
      table { page-break-inside: avoid; }
      tr { page-break-inside: avoid; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      .font-urdu { font-size: 14pt; line-height: 2.8; }
    }
    .print-header { display: none; }
  </style>

  <div class="bg-slate-100 border-b border-slate-200 py-3 px-4 breadcrumbs no-print w-full overflow-hidden">
    <div class="max-w-5xl mx-auto text-sm text-slate-500 flex flex-wrap items-center gap-2">
      <Link href={`${import.meta.env.BASE_URL}/`} class="hover:text-blue-600">Home</Link> <span>/</span>
      <Link href={`${import.meta.env.BASE_URL}/pairing-schemes/`} class="hover:text-blue-600">Pairing Schemes</Link> <span>/</span>
      <span class="text-slate-900 font-medium">Class 10 Mathematics</span>
    </div>
  </div>

  <section class="bg-white pt-12 pb-8 px-4 border-b border-slate-200 w-full overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <div class="print-header">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-orange-600 text-white rounded flex items-center justify-center font-bold text-lg">T</div>
          <span class="text-xl font-extrabold text-slate-900">TaleemMarkaz</span>
        </div>
        <span class="text-sm font-semibold text-slate-500">taleemmarkaz.com</span>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-orange-700 text-xs font-bold uppercase tracking-wider mb-4 no-print">
        🚨 Official Government Update
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Class 10 Mathematics Pairing Scheme 2027 <span class="text-orange-600">(Punjab Boards)</span>
      </h1>
      <p class="text-lg text-slate-600 mb-6 max-w-3xl">
        The complete, official chapter-wise Mathematics paper scheme and model paper, based on the PECTAA textbook pattern and authorized for all Punjab Boards.
      </p>

      <button onclick="window.print()" class="no-print bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-6 rounded-lg transition-colors inline-flex items-center gap-2 shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download PDF with Logo
      </button>

      <div class="author-card bg-white border border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm mt-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold text-xl md:text-2xl shrink-0 border-4 border-orange-100">NK</div>
            <div class="text-left">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Academically Reviewed By</p>
              </div>
              <Link href={`${import.meta.env.BASE_URL}/authors/`} class="text-lg md:text-xl font-extrabold text-slate-900 hover:text-orange-600 transition-colors leading-tight block">Sir Naeem Khan</Link>
              <p class="text-sm font-medium text-slate-600 mt-0.5">Mathematics Specialist | BS Mathematics</p>
            </div>
          </div>
          <div class="flex flex-row md:flex-col lg:flex-row gap-6 md:gap-2 lg:gap-6 text-sm text-slate-500 md:border-l md:border-slate-200 md:pl-6 pt-4 md:pt-0 border-t md:border-t-0 border-slate-200">
            <div><span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Published</span><span class="font-semibold text-slate-700">Nov 8, 2026</span></div>
            <div><span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Updated</span><span class="font-semibold text-slate-700">Nov 8, 2026</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12 w-full overflow-hidden">
    <div class="prose prose-slate prose-lg max-w-none text-slate-700">
      
      <div class="bg-blue-50 border-l-4 border-blue-600 p-6 rounded-r-xl mb-10 not-prose">
        <h3 class="text-xl font-bold text-blue-900 mb-3 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Official Announcement by Punjab Education Minister
        </h3>
        <p class="text-blue-800 mb-4"><strong>This is the official 2027 Mathematics paper pattern for all Punjab Boards.</strong></p>
        <p class="text-blue-800 mb-4">Punjab Education Minister <strong>Rana Sikandar Hayat</strong> has officially authorized the inclusion of pairing schemes directly into the 2027 PCTB curriculum textbooks for Class 9 and Class 10.</p>
        <div class="bg-white/60 p-4 rounded-lg border border-blue-100">
          <p class="text-sm text-blue-900">The Minister noted that private schools were illegally obtaining pairing schemes to gain an unfair advantage. To ensure <strong>100% fair competition</strong>, the government has now printed these schemes inside the official textbooks.</p>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 my-8 not-prose" dir="rtl">
        <h3 class="text-2xl font-bold text-slate-900 mb-4 font-urdu">اہم امتحانی ہدایات</h3>
        <ul class="space-y-4 text-slate-700 font-urdu">
          <li>• اس پیپر میں کل 75 نمبر ہیں جن میں 15 نمبر معروضی (MCQs) اور 60 نمبر سوالیہ (Subjective) ہیں۔</li>
          <li>• پیپر کا وقت 2 گھنٹے 30 منٹ ہوگا۔ معروضی حصے کے لیے 20 منٹ اور سوالیہ حصے کے لیے 2 گھنٹے 10 منٹ ہوں گے۔</li>
          <li>• سوالیہ حصے میں Q.2, Q.3 اور Q.4 شامل ہیں، ہر سوال میں 9 میں سے 6 سوالات حل کرنے ہوں گے۔</li>
          <li>• طویل سوالات میں Q.5 تا Q.7 میں سے 2 سوال اور Q.8 تا Q.9 میں سے 1 سوال حل کرنا ہوگا۔</li>
          <li>• ریاضی کے پیپر میں فارمولے اور اقدامات (Steps) لکھنا لازمی ہے، صرف جواب لکھنے پر نمبر نہیں ملتے۔</li>
        </ul>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Paper Pattern & Marks Distribution</h2>
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900">Category</th>
              <th class="p-3 font-bold text-slate-900">Details</th>
              <th class="p-3 font-bold text-slate-900 text-center">Marks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900">Objective (MCQs)</td>
              <td class="p-3">Q-1: 15 MCQs from the entire textbook. One MCQ each from Ch 1, 2, 3, 4, 5, 6, 7, 8, 10. Two MCQs each from Ch 9, 11, 12.</td>
              <td class="p-3 text-center font-bold text-orange-600">15</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900">Part-I: Subjective (Q.2)</td>
              <td class="p-3">Attempt 6 out of 9 short questions. At least two from Ch 1, 2, 3, 4.</td>
              <td class="p-3 text-center">12</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900">Part-I: Subjective (Q.3)</td>
              <td class="p-3">Attempt 6 out of 9 short questions. At least two from Ch 5, 6, 7, 8.</td>
              <td class="p-3 text-center">12</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900">Part-I: Subjective (Q.4)</td>
              <td class="p-3">Attempt 6 out of 9 short questions. At least two from Ch 9, 10, 11, 12.</td>
              <td class="p-3 text-center">12</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900">Part-II: Subjective (Q.5-Q.7)</td>
              <td class="p-3">Long questions, bifurcated into (a) & (b) of 4 marks each. Attempt any 2.</td>
              <td class="p-3 text-center">16</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-medium text-slate-900">Part-III: Subjective (Q.8-Q.9)</td>
              <td class="p-3">Long questions, bifurcated into (a) & (b) of 4 marks each. Attempt any 1.</td>
              <td class="p-3 text-center">8</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Long Questions Selection (Chapter Pairing)</h2>
      <div class="overflow-x-auto w-full max-w-full my-6 border border-slate-200 rounded-lg not-prose">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200">
              <th class="p-3 font-bold text-slate-900">Question</th>
              <th class="p-3 font-bold text-slate-900">Part (a) - 4 Marks</th>
              <th class="p-3 font-bold text-slate-900">Part (b) - 4 Marks</th>
              <th class="p-3 font-bold text-slate-900 text-center">Selection</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.5</td><td class="p-3">Chapter 1</td><td class="p-3">Chapter 2</td><td class="p-3 text-center font-bold text-orange-600" rowspan="3">Any 2</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.6</td><td class="p-3">Chapter 3</td><td class="p-3">Chapter 4</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.7</td><td class="p-3">Chapter 5</td><td class="p-3">Chapter 7</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.8</td><td class="p-3">Chapter 6</td><td class="p-3">Chapter 8 or 11</td><td class="p-3 text-center font-bold text-orange-600" rowspan="2">Any 1</td></tr>
            <tr class="hover:bg-slate-50"><td class="p-3 font-medium text-slate-900">Q.9</td><td class="p-3">Chapter 10</td><td class="p-3">Chapter 9 or 12</td></tr>
          </tbody>
        </table>
      </div>

      <!-- MODEL PAPER SECTION -->
      <h2 class="text-2xl font-extrabold text-slate-900 mt-12 mb-4 border-b border-slate-200 pb-2">Official PECTAA Model Paper 2027</h2>
      
      <!-- Objective -->
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden not-prose my-6">
        <div class="bg-slate-100 p-4 border-b border-slate-200">
          <h3 class="text-lg font-bold text-slate-900">Objective Type (معروضی طرز)</h3>
          <p class="text-sm text-slate-600">Time Allowed: 20 Min. | Max. Marks: 15</p>
        </div>
        <div class="p-4 w-full overflow-hidden">
          <p class="text-sm text-slate-700 mb-4 font-medium"><strong>Note:</strong> Four possible answers A, B, C and D to each question are given. The choice which you think is correct, fill that circle in front of that question.</p>
          
          <div class="overflow-x-auto w-full max-w-full">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                  <th class="p-3 font-bold text-slate-900 border-r border-slate-200 w-12 text-center">#</th>
                  <th class="p-3 font-bold text-slate-900 border-r border-slate-200">Questions</th>
                  <th class="p-3 font-bold text-slate-900 text-center border-r border-slate-200">A</th>
                  <th class="p-3 font-bold text-slate-900 text-center border-r border-slate-200">B</th>
                  <th class="p-3 font-bold text-slate-900 text-center border-r border-slate-200">C</th>
                  <th class="p-3 font-bold text-slate-900 text-center">D</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700">
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">i</td><td class="p-3 border-r border-slate-100"><Math math={String.raw`i^{27} + i^{25} =`} /></td><td class="p-3 border-r border-slate-100 text-center">-1</td><td class="p-3 border-r border-slate-100 text-center">0</td><td class="p-3 border-r border-slate-100 text-center">1</td><td class="p-3 text-center">2</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">ii</td><td class="p-3 border-r border-slate-100">What is the discriminant of <Math math={String.raw`x^2 + 5x - 5 = 0`} />?</td><td class="p-3 border-r border-slate-100 text-center">-20</td><td class="p-3 border-r border-slate-100 text-center">20</td><td class="p-3 border-r border-slate-100 text-center">25</td><td class="p-3 text-center">45</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">iii</td><td class="p-3 border-r border-slate-100">If <Math math={String.raw`A^t = -A`} />, then A is ______ matrix.</td><td class="p-3 border-r border-slate-100 text-center">Square</td><td class="p-3 border-r border-slate-100 text-center">Skew-symmetric</td><td class="p-3 border-r border-slate-100 text-center">Row</td><td class="p-3 text-center">Rectangular</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">iv</td><td class="p-3 border-r border-slate-100">A function f from X to Y is represented by:</td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`f: Y \to X`} /></td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`f: X \to Y`} /></td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`f: X/Y`} /></td><td class="p-3 text-center">None</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">v</td><td class="p-3 border-r border-slate-100">Lowest form of <Math math={String.raw`\frac{15xyz}{10}`} /> is:</td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`\frac{3xyz}{2}`} /></td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`\frac{3}{2}xyz`} /></td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`\frac{xyz}{2}`} /></td><td class="p-3 text-center">None</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">vi</td><td class="p-3 border-r border-slate-100"><Math math={String.raw`P(4, -4)`} /> lies in ______ quadrant.</td><td class="p-3 border-r border-slate-100 text-center">1st</td><td class="p-3 border-r border-slate-100 text-center">2nd</td><td class="p-3 border-r border-slate-100 text-center">3rd</td><td class="p-3 text-center">4th</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">vii</td><td class="p-3 border-r border-slate-100"><Math math={String.raw`\sin(90^\circ + \theta) =`} /></td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`\sin \theta`} /></td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`-\sin \theta`} /></td><td class="p-3 border-r border-slate-100 text-center"><Math math={String.raw`\cos \theta`} /></td><td class="p-3 text-center"><Math math={String.raw`-\cos \theta`} /></td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">viii</td><td class="p-3 border-r border-slate-100">The sum of the measures of central angles of a circle is:</td><td class="p-3 border-r border-slate-100 text-center">90°</td><td class="p-3 border-r border-slate-100 text-center">180°</td><td class="p-3 border-r border-slate-100 text-center">270°</td><td class="p-3 text-center">360°</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">ix</td><td class="p-3 border-r border-slate-100">______ tangents can be drawn to a circle from a point outside.</td><td class="p-3 border-r border-slate-100 text-center">One</td><td class="p-3 border-r border-slate-100 text-center">Two</td><td class="p-3 border-r border-slate-100 text-center">Three</td><td class="p-3 text-center">Many</td></tr>
                <tr><td class="p-3 border-r border-slate-100 text-center font-bold">x</td><td class="p-3 border-r border-slate-100">If <Math math={String.raw`r=6cm, \theta=2`} /> radians, then arc length is:</td><td class="p-3 border-r border-slate-100 text-center">12 cm</td><td class="p-3 border-r border-slate-100 text-center">8 cm</td><td class="p-3 border-r border-slate-100 text-center">6 cm</td><td class="p-3 text-center">3 cm</td></tr>
