---
import Layout from '../../layouts/Layout.astro';

// Article & FAQ Schema for Rich Results
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Class 10 Physics Pairing Scheme 2027 Punjab Board",
      "description": "Official chapter-wise marks distribution for 10th Class Physics 2027 Punjab Board. MCQs, Short Questions, and Long Questions breakdown.",
      "author": {
        "@type": "Person",
        "name": "Malik Muhammad Ahsan Jahangir",
        "url": "https://taleemmarkaz.com/authors/malik-muhammad-ahsan-jahangir/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "TaleemMarkaz",
        "logo": {
          "@type": "ImageObject",
          "url": "https://taleemmarkaz.com/logo.png"
        }
      },
      "datePublished": "2026-11-01",
      "dateModified": "2026-11-08"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many total marks are there in 10th Class Physics Punjab Board?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The total marks for 10th Class Physics are 75. This includes 15 marks for Objective (MCQs) and 60 marks for Subjective (Short and Long Questions)."
          }
        },
        {
          "@type": "Question",
          "name": "Which chapter has the most marks in 10th Class Physics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chapters 13 (Electrostatics), 14 (Current Electricity), and 15 (Electromagnetism) are the most important, collectively carrying over 30 marks in the subjective part."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title="Class 10 Physics Pairing Scheme 2027 Punjab Board (Marks Breakdown) | TaleemMarkaz"
  description="Download the official 10th Class Physics Pairing Scheme 2027 for Punjab Boards. Get chapter-wise marks distribution for MCQs, Short, and Long Questions with expert analysis."
  canonical="https://taleemmarkaz.com/pairing-schemes/class-10-physics/"
  schema={schema}
>
  <!-- Breadcrumbs -->
  <div class="bg-slate-100 border-b border-slate-200 py-3 px-4">
    <div class="max-w-5xl mx-auto text-sm text-slate-500 flex items-center gap-2">
      <a href="/" class="hover:text-blue-600">Home</a> <span>/</span>
      <a href="/pairing-schemes/" class="hover:text-blue-600">Pairing Schemes</a> <span>/</span>
      <span class="text-slate-900 font-medium">Class 10 Physics</span>
    </div>
  </div>

  <!-- Header -->
  <section class="bg-white pt-12 pb-8 px-4 border-b border-slate-200">
    <div class="max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold uppercase tracking-wider mb-4">
        Updated for 2027 Session
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Class 10 Physics Pairing Scheme 2027 <span class="text-blue-600">(Punjab Board)</span>
      </h1>
      <p class="text-lg text-slate-600 mb-6 max-w-3xl">
        The official chapter-wise marks distribution for the 10th Class Physics board exam. Use this scheme to prioritize high-weight chapters and score maximum marks.
      </p>

      <!-- Author E-E-A-T Block -->
      <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 p-3 rounded-lg w-fit">
        <div class="w-10 h-10 bg-blue-600 text-white rounded-lg flex items-center justify-center font-bold text-sm">MA</div>
        <div>
          <p class="text-sm font-bold text-slate-900">Reviewed by Malik Muhammad Ahsan Jahangir</p>
          <p class="text-xs text-slate-500">BS (Hons) Microbiology & MPhil Biotechnology</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="max-w-4xl mx-auto px-4 py-12">
    
    <!-- Quick Summary Alert -->
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-10">
      <h2 class="text-lg font-bold text-blue-900 mb-2 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Quick Exam Info
      </h2>
      <ul class="text-sm text-blue-800 space-y-1 font-medium">
        <li>• <strong>Total Marks:</strong> 75 (Objective: 15, Subjective: 60)</li>
        <li>• <strong>Exam Duration:</strong> 2 Hours 40 Minutes (Objective: 20 mins, Subjective: 2 hrs 20 mins)</li>
        <li>• <strong>Long Questions:</strong> Attempt 3 out of 5 (20 Marks)</li>
        <li>• <strong>Short Questions:</strong> Attempt 12 out of 15 (24 Marks)</li>
      </ul>
    </div>

    <div class="prose prose-slate prose-lg max-w-none">
      <h2 class="text-2xl font-extrabold text-slate-900 mb-4 border-b border-slate-200 pb-2">Chapter-Wise Marks Distribution</h2>
      <p>Below is the official paper pattern for BISE Punjab Class 10 Physics. Note that while the board provides the structure, the exact chapters can vary slightly. However, historical trends show these chapters are consistently tested.</p>

      <!-- MCQs Table -->
      <h3 class="text-xl font-bold text-slate-900 mt-8 mb-3">1. Objective Part (MCQs) - 15 Marks</h3>
      <div class="overflow-x-auto my-4">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b-2 border-slate-300">
              <th class="p-3 font-bold text-slate-900">Chapter No.</th>
              <th class="p-3 font-bold text-slate-900">Topic Name</th>
              <th class="p-3 font-bold text-slate-900 text-center">No. of MCQs</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="p-3">10</td><td class="p-3">Simple Harmonic Motion & Waves</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">11</td><td class="p-3">Sound</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">12</td><td class="p-3">Geometrical Optics</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">13</td><td class="p-3">Electrostatics</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">14</td><td class="p-3">Current Electricity</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">15</td><td class="p-3">Electromagnetism</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">16</td><td class="p-3">Basic Electronics</td><td class="p-3 text-center">1</td></tr>
            <tr><td class="p-3">17</td><td class="p-3">Information & Communication Technology</td><td class="p-3 text-center">1</td></tr>
            <tr><td class="p-3">18</td><td class="p-3">Atomic & Nuclear Physics</td><td class="p-3 text-center">1</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Short Questions Table -->
      <h3 class="text-xl font-bold text-slate-900 mt-10 mb-3">2. Subjective Part (Short Questions) - 24 Marks</h3>
      <p class="text-sm text-slate-600 mb-4">You will be given 15 questions, out of which you must attempt any 12. Each question carries 2 marks.</p>
      <div class="overflow-x-auto my-4">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b-2 border-slate-300">
              <th class="p-3 font-bold text-slate-900">Chapter</th>
              <th class="p-3 font-bold text-slate-900 text-center">Questions to Attempt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="p-3">Chapter 10 & 11 (Waves & Sound)</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">Chapter 12 (Optics)</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">Chapter 13 (Electrostatics)</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">Chapter 14 (Current Electricity)</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">Chapter 15 (Electromagnetism)</td><td class="p-3 text-center">2</td></tr>
            <tr><td class="p-3">Chapter 16, 17, 18</td><td class="p-3 text-center">1 each</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Long Questions Table -->
      <h3 class="text-xl font-bold text-slate-900 mt-10 mb-3">3. Subjective Part (Long Questions) - 20 Marks</h3>
      <p class="text-sm text-slate-600 mb-4">You will be given 5 questions, out of which you must attempt any 3. Each question carries 5 marks (Part A) and 3 marks (Part B).</p>
      <div class="overflow-x-auto my-4">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b-2 border-slate-300">
              <th class="p-3 font-bold text-slate-900">Question No.</th>
              <th class="p-3 font-bold text-slate-900">Chapters Covered</th>
              <th class="p-3 font-bold text-slate-900">Total Marks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="p-3">Q.1</td><td class="p-3">Chapter 10 (Simple Harmonic Motion)</td><td class="p-3">8</td></tr>
            <tr><td class="p-3">Q.2</td><td class="p-3">Chapter 12 (Geometrical Optics)</td><td class="p-3">8</td></tr>
            <tr><td class="p-3">Q.3</td><td class="p-3">Chapter 13 & 14 (Electrostatics & Current)</td><td class="p-3">8</td></tr>
            <tr><td class="p-3">Q.4</td><td class="p-3">Chapter 15 (Electromagnetism)</td><td class="p-3">8</td></tr>
            <tr><td class="p-3">Q.5</td><td class="p-3">Chapter 17 & 18 (ICT & Nuclear Physics)</td><td class="p-3">8</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Urdu Instructions (Massive SEO Win) -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 my-10" dir="rtl">
        <h3 class="text-xl font-bold text-slate-900 mb-4 font-urdu">اہم ہدایات برائے طلباء (Important Instructions)</h3>
        <ul class="space-y-3 text-slate-700 text-right">
          <li>• پیپر میں کل 75 نمبر ہیں، جن میں سے 15 نمبر معروضی (MCQs) کے اور 60 نمبر سوالیہ (Subjective) کے ہیں۔</li>
          <li>• معروضی حصے کو حل کرنے کے لیے 20 منٹ دیے جائیں گے۔</li>
          <li>• طویل سوالات میں سے صرف 3 سوالات حل کرنے ہوں گے، جبکہ مختصر سوالات میں سے 12 سوالات حل کرنے ہوں گے۔</li>
          <li>• ہمیشہ یاد رکھیں کہ باب 13 اور 14 (Electrostatics اور Current Electricity) سب سے زیادہ اہمیت کے حامل ہیں، انہیں ضرور تیار کریں۔</li>
        </ul>
      </div>

      <!-- Expert Tips (Information Gain) -->
      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Expert Tips to Score 70+ in Physics</h2>
      <div class="space-y-4">
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">1. Focus on Numericals</h4>
          <p class="text-sm text-slate-600">The Punjab Board heavily rewards numerical problems. Chapters 13 (Electrostatics) and 14 (Current Electricity) almost always feature 2 numericals each. Memorize the formulas for Series and Parallel circuits.</p>
        </div>
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">2. Don't Skip Chapter 18</h4>
          <p class="text-sm text-slate-600">Many students ignore Atomic and Nuclear Physics because it's the last chapter. However, it contains very easy, theory-based MCQs and short questions. Reading it for just 1 hour can guarantee you 4-5 marks.</p>
        </div>
      </div>

      <!-- FAQ Section -->
      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-6 border-b border-slate-200 pb-2">Frequently Asked Questions</h2>
      <div class="space-y-4 not-prose">
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">Is this pairing scheme for all Punjab boards?</h4>
          <p class="text-sm text-slate-600">Yes, this scheme is applicable for all BISE Punjab boards including Lahore, Multan, Rawalpindi, Faisalabad, Gujranwala, Sargodha, Bahawalpur, DG Khan, and Sahiwal.</p>
        </div>
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">Will the 2027 paper follow this exact scheme?</h4>
          <p class="text-sm text-slate-600">The paper structure (15 MCQs, 12 Short Qs, 3 Long Qs) remains constant. However, always consult the official BISE notification for any last-minute syllabus changes.</p>
        </div>
      </div>

    </div>
  </section>
</Layout>