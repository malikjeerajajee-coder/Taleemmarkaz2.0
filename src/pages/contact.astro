---
import Layout from "../layouts/Layout.astro";

const siteUrl = "https://taleemmarkaz.com";
const pageUrl = `${siteUrl}/contact/`;

const title = "Contact TaleemMarkaz | WhatsApp, Email & Support";
const description = "Contact TaleemMarkaz for educational questions, past paper corrections, study material feedback, technical support, and general inquiries. Reach us through WhatsApp or email.";

const phone = "+923379244731";
const displayPhone = "+92 337 9244731";
const email = "taleemmarkazofficial@gmail.com";
const whatsappUrl = `https://wa.me/${phone.replace("+", "")}?text=${encodeURIComponent("Assalam-o-Alaikum, I would like to contact TaleemMarkaz.")}`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": `${pageUrl}#webpage`,
      name: title,
      url: pageUrl,
      description,
      inLanguage: ["en-PK", "ur-PK"],
      isPartOf: { "@id": `${siteUrl}/#website` },
      about: { "@id": `${siteUrl}/#organization` },
      author: {
        "@type": "Person",
        "name": "Malik Muhammad Ahsan Jahangir",
        "jobTitle": "Lead Academic Author",
        "alumniOf": "MPhil Biotechnology"
      }
    },
    {
      "@type": "EducationalOrganization",
      "@id": `${siteUrl}/#organization`,
      name: "TaleemMarkaz",
      url: siteUrl,
      email: email,
      telephone: phone,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        telephone: phone,
        email: email,
        availableLanguage: ["English", "Urdu"],
        url: whatsappUrl,
      },
    },
  ],
};
---

<Layout title={title} description={description} canonical={pageUrl} schema={schema}>
  <!-- Custom CSS for Smooth Scrolling and Gulzar Font -->
  <style is:global>
    html { scroll-behavior: smooth; }
    .font-urdu, .font-urdu * {
      font-family: 'Gulzar', serif !important;
      line-height: 2.15 !important;
    }
    .font-urdu h2, .font-urdu h3 { line-height: 1.9 !important; }
  </style>

  <!-- Breadcrumbs -->
  <div class="bg-slate-100 border-b border-slate-200 py-3 px-4 no-print">
    <div class="max-w-5xl mx-auto text-sm text-slate-500 flex items-center gap-2">
      <a href={`${import.meta.env.BASE_URL}/`} class="hover:text-blue-600 transition-colors">Home</a> <span>/</span>
      <span class="text-slate-900 font-semibold" aria-current="page">Contact Us</span>
    </div>
  </div>

  <!-- Hero Section -->
  <header class="relative bg-white border-b border-slate-200 px-4 py-16 md:py-20 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-[0.03]" style="background-image: radial-gradient(#2563eb 1px, transparent 1px); background-size: 24px 24px;"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <span class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 border border-blue-100 rounded-full px-4 py-1.5 text-sm font-bold mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        We Are Here To Help
      </span>

      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight mb-6">
        Contact <span class="text-blue-600">TaleemMarkaz</span>
      </h1>

      <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto mb-10">
        Have a question, suggestion, or correction to share? We'd love to hear from you. Get in touch with our team using any of the methods below.
      </p>

      <!-- AUTHOR & DATE E-E-A-T BLOCK -->
      <div class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-2xl p-5 md:p-6 text-left">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xl md:text-2xl shrink-0 border-4 border-blue-100">
              MA
            </div>
            <div>
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Page Maintained By</span>
              </div>
              <a href={`${import.meta.env.BASE_URL}/authors/`} class="block text-lg md:text-xl font-extrabold text-slate-900 hover:text-blue-600 transition-colors">
                Malik Muhammad Ahsan Jahangir
              </a>
              <p class="text-sm text-slate-600 mt-0.5">
                Lead Academic Author | BS (Hons) Microbiology & MPhil Biotechnology
              </p>
            </div>
          </div>

          <div class="flex flex-row md:flex-col lg:flex-row gap-6 md:gap-2 lg:gap-6 text-sm text-slate-500 md:border-l md:border-slate-200 md:pl-6 pt-4 md:pt-0 border-t md:border-t-0 border-slate-200">
            <div>
              <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Updated</span>
              <time datetime="2026-11-08" class="font-semibold text-slate-700">Nov 8, 2026</time>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-5xl mx-auto px-4 py-16">
    
    <!-- Contact Options Grid -->
    <section class="mb-20">
      <div class="text-center mb-10">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">Get In Touch</span>
        <h2 class="text-3xl font-extrabold text-slate-900 mt-2">How Can We Help You?</h2>
        <p class="text-slate-500 mt-2">Choose the contact method that works best for you.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- WhatsApp -->
        <article class="bg-white border border-slate-200 rounded-2xl p-6 text-center flex flex-col items-center hover:border-green-500 transition-colors">
          <div class="w-14 h-14 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">WhatsApp</h3>
          <p class="text-sm text-slate-600 mb-4 flex-grow">Message us directly for general questions, feedback, and inquiries.</p>
          <strong class="text-slate-900 font-bold mb-5">{displayPhone}</strong>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
            Chat on WhatsApp
          </a>
        </article>

        <!-- Email -->
        <article class="bg-white border border-slate-200 rounded-2xl p-6 text-center flex flex-col items-center hover:border-blue-500 transition-colors">
          <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Email</h3>
          <p class="text-sm text-slate-600 mb-4 flex-grow">Send us detailed questions, correction requests, or suggestions.</p>
          <strong class="text-slate-900 font-bold mb-5 text-sm break-all">{email}</strong>
          <a href={`mailto:${email}?subject=Inquiry - TaleemMarkaz`} class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
            Send an Email
          </a>
        </article>

        <!-- Phone -->
        <article class="bg-white border border-slate-200 rounded-2xl p-6 text-center flex flex-col items-center hover:border-orange-500 transition-colors">
          <div class="w-14 h-14 bg-orange-50 text-orange-600 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Phone</h3>
          <p class="text-sm text-slate-600 mb-4 flex-grow">Use our contact number for direct phone inquiries when available.</p>
          <strong class="text-slate-900 font-bold mb-5">{displayPhone}</strong>
          <a href={`tel:${phone}`} class="w-full bg-white border border-slate-300 hover:bg-slate-50 text-slate-900 font-bold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
            Call Us
          </a>
        </article>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section id="contact-form" class="mb-20 scroll-mt-24">
      <div class="grid md:grid-cols-12 gap-10 items-start">
        
        <!-- Form Info -->
        <div class="md:col-span-5">
          <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">Send Us a Message</span>
          <h2 class="text-3xl font-extrabold text-slate-900 mt-2 mb-4">Let's Start a Conversation</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">Use the form to share your question, report an issue, or send feedback about TaleemMarkaz.</p>

          <div class="space-y-5 mb-8">
            <div class="flex gap-3">
              <svg class="w-5 h-5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <div>
                <h4 class="font-bold text-slate-900 text-sm">Educational Questions</h4>
                <p class="text-xs text-slate-500 mt-1">Ask about our study resources and learning materials.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <svg class="w-5 h-5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <div>
                <h4 class="font-bold text-slate-900 text-sm">Corrections and Feedback</h4>
                <p class="text-xs text-slate-500 mt-1">Report incorrect answers, outdated information, or broken links.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <svg class="w-5 h-5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <div>
                <h4 class="font-bold text-slate-900 text-sm">General Inquiries</h4>
                <p class="text-xs text-slate-500 mt-1">Share suggestions and other relevant questions.</p>
              </div>
            </div>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
            <h4 class="font-bold text-slate-900 text-sm mb-2">Privacy matters</h4>
            <p class="text-xs text-slate-600 leading-relaxed mb-3">Please avoid sharing passwords, identity documents, or other sensitive personal information through this form.</p>
            <a href={`${import.meta.env.BASE_URL}/privacy-policy/`} class="text-xs font-bold text-blue-600 hover:underline">Read our Privacy Policy →</a>
          </div>
        </div>

        <!-- Form Card -->
        <div class="md:col-span-7 bg-white border border-slate-200 rounded-2xl p-6 md:p-8">
          <h3 class="text-xl font-bold text-slate-900 mb-1">Send a Message</h3>
          <p class="text-sm text-slate-500 mb-6">Fill in the details below.</p>

          <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="space-y-4">
            <!-- Note: Replace the formspree URL with your actual backend URL later -->
            
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-bold text-slate-700 mb-1">Full Name *</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors text-sm">
              </div>
              <div>
                <label for="email" class="block text-sm font-bold text-slate-700 mb-1">Email Address *</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors text-sm">
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="subject" class="block text-sm font-bold text-slate-700 mb-1">Reason for Contact *</label>
                <select id="subject" name="subject" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors text-sm bg-white">
                  <option value="">Select a subject</option>
                  <option value="General Inquiry">General Inquiry</option>
                  <option value="Educational Question">Educational Question</option>
                  <option value="Past Paper Correction">Past Paper Correction</option>
                  <option value="Technical Issue">Technical Issue</option>
                  <option value="Collaboration">Collaboration</option>
                </select>
              </div>
              <div>
                <label for="pageUrl" class="block text-sm font-bold text-slate-700 mb-1">Related URL (Optional)</label>
                <input type="url" id="pageUrl" name="pageUrl" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors text-sm">
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-bold text-slate-700 mb-1">Your Message *</label>
              <textarea id="message" name="message" rows="5" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors text-sm resize-y"></textarea>
            </div>

            <div class="flex items-start gap-2 pt-2">
              <input type="checkbox" id="privacy" name="privacy" required class="mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500">
              <label for="privacy" class="text-xs text-slate-600 leading-relaxed">
                I agree to the processing of my information according to the <a href={`${import.meta.env.BASE_URL}/privacy-policy/`} class="text-blue-600 font-bold hover:underline">Privacy Policy</a>.
              </label>
            </div>

            <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 rounded-lg transition-colors mt-4">
              Send Message
            </button>
          </form>
        </div>

      </div>
    </section>

  </main>

  <!-- Urdu Section -->
  <section class="bg-slate-50 border-t border-slate-200 py-16 px-4 font-urdu" lang="ur" dir="rtl">
    <div class="max-w-5xl mx-auto">
      
      <div class="text-center mb-12">
        <span class="text-sm font-bold text-blue-600">ہم سے رابطہ کریں</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-3 mb-4">تعلیم مرکز سے رابطہ کیسے کریں؟</h2>
        <p class="text-xl text-slate-600">آپ کے سوالات، تجاویز اور آراء ہمارے لیے اہم ہیں۔ ہم سے رابطہ کرنے کے لیے درج ذیل ذرائع استعمال کریں۔</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 text-lg text-slate-800">
        <!-- Urdu WhatsApp -->
        <article class="bg-white border border-slate-200 p-6 rounded-xl text-center">
          <h3 class="font-bold text-slate-900 mb-3">واٹس ایپ</h3>
          <p class="text-slate-600 text-sm mb-4 h-16">تعلیمی سوالات، تجاویز یا عمومی معلومات کے لیے ہمیں واٹس ایپ پر پیغام بھیجیں۔</p>
          <strong class="block text-slate-900 mb-4" dir="ltr">{displayPhone}</strong>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-block bg-green-50 text-green-700 font-bold px-4 py-2 rounded-lg hover:bg-green-100 transition-colors">پیغام بھیجیں</a>
        </article>
        
        <!-- Urdu Email -->
        <article class="bg-white border border-slate-200 p-6 rounded-xl text-center">
          <h3 class="font-bold text-slate-900 mb-3">ای میل</h3>
          <p class="text-slate-600 text-sm mb-4 h-16">سوالات، شکایات اور تجاویز کے لیے ہمیں ای میل بھیجیں۔</p>
          <strong class="block text-slate-900 mb-4 text-sm" dir="ltr">{email}</strong>
          <a href={`mailto:${email}`} class="inline-block bg-blue-50 text-blue-700 font-bold px-4 py-2 rounded-lg hover:bg-blue-100 transition-colors">ای میل بھیجیں</a>
        </article>

        <!-- Urdu Phone -->
        <article class="bg-white border border-slate-200 p-6 rounded-xl text-center">
          <h3 class="font-bold text-slate-900 mb-3">فون</h3>
          <p class="text-slate-600 text-sm mb-4 h-16">فون پر رابطے کے لیے ہمارا درج ذیل نمبر استعمال کریں۔</p>
          <strong class="block text-slate-900 mb-4" dir="ltr">{displayPhone}</strong>
          <a href={`tel:${phone}`} class="inline-block bg-slate-100 text-slate-700 font-bold px-4 py-2 rounded-lg hover:bg-slate-200 transition-colors">ہمیں کال کریں</a>
        </article>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center mt-6">
        <h3 class="text-2xl font-bold text-slate-900 mb-3">آپ کی رائے ہمارے لیے اہم ہے</h3>
        <p class="text-slate-600 mb-6 text-lg">اگر آپ کو ہماری ویب سائٹ پر کسی معلومات میں غلطی نظر آئے، کوئی لنک کام نہ کر رہا ہو یا آپ کوئی تجویز دینا چاہتے ہوں تو براہِ کرم ہم سے رابطہ کریں۔</p>
        <a href="#contact-form" class="inline-block bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-3 rounded-lg transition-colors">رابطہ فارم پر جائیں ←</a>
      </div>

    </div>
  </section>

  <!-- FAQs -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">Common Questions</span>
      <h2 class="text-3xl font-extrabold text-slate-900 mt-2">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-4">
      <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden">
        <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer p-5 hover:bg-slate-50 transition-colors list-none">
          How can I contact TaleemMarkaz?
          <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-4">
          You can contact us through WhatsApp, phone, email, or the contact form on this page.
        </div>
      </details>

      <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden">
        <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer p-5 hover:bg-slate-50 transition-colors list-none">
          How can I report an incorrect answer?
          <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-4">
          Select "Content Error" or "Past Paper Correction" in the contact form. Include the page URL and explain the issue so it can be reviewed.
        </div>
      </details>

      <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden">
        <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer p-5 hover:bg-slate-50 transition-colors list-none">
          Can I suggest new educational resources?
