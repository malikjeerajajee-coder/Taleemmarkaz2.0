---
import Layout from '../../layouts/Layout.astro';

// Comprehensive Person & Profile Schema
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Malik Muhammad Ahsan Jahangir",
  "jobTitle": "Lead Academic Author & Educational Content Reviewer",
  "description": "BS (Hons) Microbiology | MPhil Biotechnology. Academic contributor and reviewer at TaleemMarkaz.",
  "url": "https://taleemmarkaz.com/authors/malik-muhammad-ahsan-jahangir/",
  "worksFor": {
    "@type": "Organization",
    "name": "TaleemMarkaz",
    "url": "https://taleemmarkaz.com/"
  },
  "alumniOf": [
    {
      "@type": "EducationalOrganization",
      "name": "MPhil in Biotechnology"
    },
    {
      "@type": "EducationalOrganization",
      "name": "BS (Hons) in Microbiology"
    }
  ],
  "knowsAbout": [
    "Microbiology",
    "Biology",
    "Life Sciences",
    "Biotechnology",
    "Scientific Educational Content",
    "Biology Curriculum Content"
  ]
};
---

<Layout 
  title="Malik Muhammad Ahsan Jahangir – Academic Author & Biology Reviewer | TaleemMarkaz"
  description="Meet Malik Muhammad Ahsan Jahangir, TaleemMarkaz's Lead Academic Author. Explore his Microbiology and Biotechnology background and role in educational content review."
  canonical="https://taleemmarkaz.com/authors/malik-muhammad-ahsan-jahangir/"
  schema={schema}
>
  <!-- Profile Header -->
  <section class="bg-white border-b border-slate-200 pt-16 pb-12 px-4">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center md:items-start gap-8">
      
      <!-- Avatar -->
      <div class="w-40 h-40 bg-blue-600 text-white rounded-2xl flex items-center justify-center text-6xl font-extrabold shrink-0 border border-blue-700">
        MA
      </div>
      
      <!-- Info -->
      <div class="text-center md:text-left flex-grow">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 border border-green-200 text-green-700 text-xs font-bold uppercase tracking-wider mb-4">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Verified Expert
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-2">Malik Muhammad Ahsan Jahangir</h1>
        <p class="text-xl text-blue-600 font-semibold mb-4">Lead Academic Author & Educational Content Reviewer</p>
        
        <div class="flex flex-wrap justify-center md:justify-start gap-3 text-sm text-slate-600">
          <span class="flex items-center gap-1.5 bg-slate-100 px-3 py-1.5 rounded-md font-medium">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
            BS (Hons) Microbiology
          </span>
          <span class="flex items-center gap-1.5 bg-slate-100 px-3 py-1.5 rounded-md font-medium">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            MPhil Biotechnology
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Profile Content -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      
      <!-- Left Column: Main Content (8 columns) -->
      <div class="md:col-span-8">
        <div class="prose prose-slate prose-lg max-w-none text-slate-700">
          
          <p class="lead text-xl text-slate-600 font-medium mb-8">
            Malik Muhammad Ahsan Jahangir is the Lead Academic Author and Reviewer at TaleemMarkaz, an independent Pakistani educational platform providing free study resources for Matric and Intermediate students.
          </p>

          <p>With academic qualifications in Microbiology and Biotechnology, his educational background provides a foundation in biological sciences, scientific concepts and subject-specific academic content.</p>

          <p>At TaleemMarkaz, he contributes to the development, organization and review of educational materials, with a focus on helping Pakistani students access understandable, relevant and academically responsible study resources.</p>

          <p>His work supports TaleemMarkaz's mission of making educational materials easier to access for students preparing for SSC (Matric) and HSSC (Intermediate) board examinations.</p>

          <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">About Malik Muhammad Ahsan Jahangir</h2>
          <p>Malik Muhammad Ahsan Jahangir is an academic content contributor with a background in Microbiology and Biotechnology. His academic training has developed his understanding of biological sciences, scientific terminology, laboratory-based concepts and the principles of biotechnology.</p>
          <p>As Lead Academic Author at TaleemMarkaz, he works toward improving the quality and accessibility of educational content available to Pakistani students.</p>
          <p>His role focuses on presenting academic information in a clear, organized and student-friendly format, particularly where biological and scientific concepts require accurate explanations.</p>
          <p>Through TaleemMarkaz, his broader objective is to help students find useful study materials without depending entirely on expensive educational subscriptions or scattered online resources.</p>

          <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Academic Qualifications</h2>
          
          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">BS (Hons) in Microbiology</h3>
          <p>His undergraduate academic background in Microbiology provides a foundation in the study of microorganisms, biological processes, microbiological principles and related life sciences. This subject knowledge is relevant to understanding scientific topics encountered in Biology and other related educational disciplines.</p>

          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">MPhil in Biotechnology</h3>
          <p>His postgraduate qualification in Biotechnology provides further academic grounding in biological applications, molecular sciences and modern biotechnology concepts. This background supports his interest in scientific education and the clear presentation of biology-related academic information.</p>

          <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Editorial Role at TaleemMarkaz</h2>
          <p>TaleemMarkaz aims to make Pakistani board examination resources easier to find, understand and use. As Lead Academic Author and Reviewer, Malik Muhammad Ahsan Jahangir contributes to the platform's educational content and its commitment to academic clarity.</p>
          
          <div class="bg-slate-50 border border-slate-200 p-6 rounded-xl my-6">
            <h4 class="font-bold text-slate-900 mb-3 mt-0">The editorial approach emphasizes:</h4>
            <ul class="space-y-2 mb-0">
              <li>Clear and understandable explanations of academic concepts.</li>
              <li>Correct use of scientific terminology.</li>
              <li>Subject and class-based organization of educational materials.</li>
              <li>Appropriate identification of relevant textbooks and curriculum resources.</li>
              <li>Attention to the academic session and applicable education board.</li>
              <li>Corrections and updates when errors or outdated information are identified.</li>
            </ul>
          </div>
          
          <p>Where a resource is described as reviewed, the review should reflect an actual review of that specific material.</p>

          <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Supporting Pakistani Matric and Intermediate Students</h2>
          <p>Students across Pakistan prepare for examinations under different educational boards, including Punjab, Federal, Sindh, Khyber Pakhtunkhwa, Balochistan and Azad Jammu and Kashmir.</p>
          <p>TaleemMarkaz brings together available educational materials for these different systems, helping students find resources according to their class, subject and board.</p>
          
          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">Our Educational Library Includes:</h3>
          <ul>
            <li>Matric and Intermediate notes.</li>
            <li>Subject-wise past papers.</li>
            <li>Educational textbooks.</li>
            <li>Chapter-based learning materials.</li>
            <li>Multiple-choice questions.</li>
            <li>Examination preparation resources.</li>
            <li>Available pairing schemes and model papers.</li>
          </ul>
          
          <p>The objective is to make educational information easier to discover while encouraging students to consult official board notifications for examination policies, syllabi and schedules.</p>

          <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Editorial Philosophy</h2>
          
          <blockquote class="border-l-4 border-blue-600 pl-6 py-2 my-6 bg-slate-50 rounded-r-lg italic text-slate-700">
            <p class="mb-4">"Quality educational resources should help students understand their subjects, not simply memorize isolated answers.</p>
            <p class="mb-4">My aim through TaleemMarkaz is to support access to clear, useful and academically responsible study materials. Students deserve resources that help them understand scientific concepts, practise examination questions and prepare with confidence."</p>
            <footer class="text-sm font-bold text-slate-900 not-italic">— Malik Muhammad Ahsan Jahangir</footer>
          </blockquote>

          <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Accuracy, Corrections and Academic Responsibility</h2>
          <p>Educational information should be clear, accurate and appropriate for its intended academic level. TaleemMarkaz encourages students, teachers and visitors to report errors, outdated references or inconsistencies in its educational materials. Reported issues can be reviewed and corrected where necessary.</p>
          <p>For official curriculum changes, examination policies, date sheets and results, students should refer to the relevant education board or government authority.</p>

          <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">About TaleemMarkaz</h2>
          <p>TaleemMarkaz is an independent Pakistani educational platform dedicated to making free academic resources more accessible to students. The platform provides educational materials for Matric and Intermediate classes, including notes, textbooks, past papers, MCQs, pairing schemes, guess papers and examination-related resources.</p>
          <p>Its mission is to simplify educational resource discovery and support students across Pakistan through accessible, organized study materials. TaleemMarkaz believes that useful educational resources should be accessible to every student, regardless of their location or financial circumstances.</p>

        </div>
      </div>

      <!-- Right Column: Sidebar (4 columns) -->
      <aside class="md:col-span-4 space-y-6">
        
        <!-- Expertise Box -->
        <div class="bg-white border border-slate-200 rounded-xl p-6">
          <h3 class="font-bold text-slate-900 mb-4 text-lg border-b border-slate-100 pb-2">Academic Expertise</h3>
          <ul class="space-y-4 text-sm text-slate-600">
            <li>
              <strong class="block text-slate-900 mb-1">Microbiology</strong>
              Understanding microorganisms, their biological characteristics, interactions and significance in biological systems.
            </li>
            <li>
              <strong class="block text-slate-900 mb-1">Biology & Life Sciences</strong>
              Knowledge of biological principles, cellular processes, living organisms and related scientific concepts.
            </li>
            <li>
              <strong class="block text-slate-900 mb-1">Biotechnology</strong>
              Academic understanding of biotechnology, biological applications and scientific developments involving living systems.
            </li>
            <li>
              <strong class="block text-slate-900 mb-1">Biology Curriculum Content</strong>
              Supporting the organization and academic presentation of Biology-related study materials for Matric and Intermediate levels.
            </li>
          </ul>
        </div>

        <!-- Biology Resources Quick Links -->
        <div class="bg-white border border-slate-200 rounded-xl p-6">
          <h3 class="font-bold text-slate-900 mb-4 text-lg border-b border-slate-100 pb-2">Biology Resources</h3>
          <ul class="space-y-2 text-sm">
            <li><a href={`${import.meta.env.BASE_URL}notes/class-9/biology/`} class="text-blue-600 hover:underline">Class 9 Biology Notes</a></li>
            <li><a href={`${import.meta.env.BASE_URL}notes/class-10/biology/`} class="text-blue-600 hover:underline">Class 10 Biology Notes</a></li>
            <li><a href={`${import.meta.env.BASE_URL}notes/class-11/biology/`} class="text-blue-600 hover:underline">1st Year Biology Notes</a></li>
            <li><a href={`${import.meta.env.BASE_URL}notes/class-12/biology/`} class="text-blue-600 hover:underline">2nd Year Biology Notes</a></li>
            <li><a href={`${import.meta.env.BASE_URL}past-papers/biology/`} class="text-blue-600 hover:underline">Biology Past Papers</a></li>
          </ul>
        </div>

        <!-- Corrections Box -->
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6">
          <h3 class="font-bold text-blue-900 mb-2 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Contact & Corrections
          </h3>
          <p class="text-sm text-blue-800 leading-relaxed mb-4">Found an error in a Biology explanation, textbook reference, past paper or other educational resource? We welcome correction requests.</p>
          <a href={`${import.meta.env.BASE_URL}contact/`} class="inline-block bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors w-full text-center">Report an Error</a>
        </div>

      </aside>
    </div>
  </section>
</Layout>