---
import Layout from '../../layouts/Layout.astro';

// Comprehensive Schema with Universities and FAQs
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": "https://taleemmarkaz.com/#organization",
      "name": "TaleemMarkaz",
      "url": "https://taleemmarkaz.com/",
      "employee": [
        { "@type": "Person", "name": "Malik Muhammad Ahsan Jahangir", "jobTitle": "Lead Academic Author", "alumniOf": "PMAS-Arid Agriculture University" },
        { "@type": "Person", "name": "Ms. Sobiya Kanwal", "jobTitle": "Chemistry Specialist", "alumniOf": "Quaid-i-Azam University" },
        { "@type": "Person", "name": "Sir Naeem Khan", "jobTitle": "Mathematics Specialist", "alumniOf": "COMSATS University Islamabad" },
        { "@type": "Person", "name": "Sir Ikhlaq Qureshi", "jobTitle": "English Specialist", "alumniOf": "University of the Punjab" },
        { "@type": "Person", "name": "Ms. Ayesha Rehman", "jobTitle": "Urdu Specialist", "alumniOf": "Quaid-i-Azam University" },
        { "@type": "Person", "name": "Ms. Naima Batool", "jobTitle": "Pakistan Studies Specialist", "alumniOf": "University of Agriculture, Faisalabad" },
        { "@type": "Person", "name": "Dr. Asrar Khan Janjua", "jobTitle": "Islamic Studies Specialist", "alumniOf": "Quaid-i-Azam University" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who are the teachers and academic contributors at TaleemMarkaz?",
          "acceptedAnswer": { "@type": "Answer", "text": "The TaleemMarkaz academic team includes contributors specializing in Biology, Chemistry, Mathematics, English, Urdu, History, Pakistan Studies and Islamic Studies." }
        },
        {
          "@type": "Question",
          "name": "Does the academic team have international teaching experience?",
          "acceptedAnswer": { "@type": "Answer", "text": "Malik Muhammad Ahsan Jahangir has experience teaching international students from the United Kingdom, United States, Canada and Australia, including students following IGCSE, O Level and A Level curricula." }
        },
        {
          "@type": "Question",
          "name": "Which subjects are covered by the academic team?",
          "acceptedAnswer": { "@type": "Answer", "text": "The listed subject areas include Biology, Chemistry, Physics, Mathematics, English, Urdu, History, Pakistan Studies and Islamic Studies." }
        }
      ]
    }
  ]
};
---

<Layout 
  title="TaleemMarkaz Faculty – Academic Team & Subject Specialists in Pakistan"
  description="Meet the TaleemMarkaz academic team, including Biology, Chemistry, Mathematics, English, Urdu, History and Islamic Studies specialists supporting Matric and Intermediate students."
  canonical="https://taleemmarkaz.com/authors/"
  schema={schema}
>
  <!-- Page Header -->
  <section class="relative bg-white border-b border-slate-200 pt-20 pb-16 px-4 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-[0.03]" style="background-image: radial-gradient(#2563eb 1px, transparent 1px); background-size: 24px 24px;"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-sm font-semibold mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Verified Academic Team
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6">
        Meet the TaleemMarkaz Academic Team
      </h1>
      <p class="text-lg text-slate-600 max-w-3xl mx-auto">
        Experienced Educators, Subject Specialists & Academic Contributors. We bring together specialists from diverse backgrounds to support students preparing for Matric, Intermediate, IGCSE, O Level, and A Level examinations.
      </p>
    </div>
  </section>

  <!-- Lead Author Spotlight -->
  <section class="max-w-6xl mx-auto px-4 pt-16 pb-8">
    <h2 class="text-2xl font-extrabold text-slate-900 mb-6 border-b border-slate-200 pb-2">Lead Academic Author</h2>
    
    <div class="bg-slate-900 rounded-3xl p-8 md:p-12 border border-slate-800">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <div class="w-32 h-32 md:w-48 md:h-48 bg-blue-600 text-white rounded-2xl flex items-center justify-center text-5xl font-extrabold shrink-0 border border-blue-500">
          MA
        </div>
        <div class="text-center md:text-left flex-grow">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-500/20 border border-green-500/30 text-green-400 text-xs font-bold uppercase tracking-wider mb-4">
            Verified Expert
          </div>
          <h3 class="text-3xl md:text-4xl font-extrabold text-white mb-2">Malik Muhammad Ahsan Jahangir</h3>
          <p class="text-blue-400 font-semibold text-lg mb-4">Lead Academic Author | Biology, Microbiology & Science Specialist</p>
          
          <p class="text-slate-300 text-sm leading-relaxed mb-6 max-w-2xl">
            With an academic background in Microbiology and Biotechnology, his subject expertise includes Biology, Chemistry, and Physics. He has over 4 years of teaching experience with both national and international students (IGCSE, O Level, A Level) from the UK, US, Canada, and Australia.
          </p>

          <div class="flex flex-wrap justify-center md:justify-start gap-2 mb-4">
            <span class="bg-slate-800 text-slate-300 text-xs px-3 py-1 rounded border border-slate-700">BS (Hons) Microbiology</span>
            <span class="bg-slate-800 text-slate-300 text-xs px-3 py-1 rounded border border-slate-700">MPhil Biotechnology</span>
            <span class="bg-slate-800 text-slate-300 text-xs px-3 py-1 rounded border border-slate-700">PMAS-Arid Agriculture University</span>
          </div>
          <a href={`${import.meta.env.BASE_URL}authors/malik-muhammad-ahsan-jahangir/`} class="text-blue-400 font-semibold text-sm hover:underline">View Full Profile →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Subject Specialists Grid -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-extrabold text-slate-900 mb-6 border-b border-slate-200 pb-2">Subject Specialists</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Chemistry -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-emerald-500 transition-colors group flex flex-col">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl font-bold shrink-0 border border-emerald-100 group-hover:bg-emerald-600 group-hover:text-white transition-colors">SK</div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Ms. Sobiya Kanwal</h3>
            <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider">Chemistry Specialist</p>
          </div>
        </div>
        <p class="text-sm text-slate-600 mb-4 flex-grow">
          Her postgraduate academic background in Chemistry provides a foundation for contributing to chemistry-related educational resources and subject learning materials.
        </p>
        <div class="text-xs text-slate-500 bg-slate-50 p-2 rounded border border-slate-100">
          <strong>Qualifications:</strong> MPhil in Chemistry<br>
          <strong>University:</strong> Quaid-i-Azam University, Islamabad
        </div>
      </article>

      <!-- Mathematics -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-orange-500 transition-colors group flex flex-col">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-orange-50 text-orange-600 rounded-xl flex items-center justify-center text-xl font-bold shrink-0 border border-orange-100 group-hover:bg-orange-600 group-hover:text-white transition-colors">NK</div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Sir Naeem Khan</h3>
            <p class="text-xs font-bold text-orange-600 uppercase tracking-wider">Mathematics Specialist</p>
          </div>
        </div>
        <p class="text-sm text-slate-600 mb-4 flex-grow">
          His academic background in Mathematics supports his focus on mathematical concepts, problem-solving, and numerical learning for secondary and higher-secondary topics.
        </p>
        <div class="text-xs text-slate-500 bg-slate-50 p-2 rounded border border-slate-100">
          <strong>Qualifications:</strong> BS in Mathematics<br>
          <strong>University:</strong> COMSATS University Islamabad
        </div>
      </article>

      <!-- English -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-purple-500 transition-colors group flex flex-col">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl font-bold shrink-0 border border-purple-100 group-hover:bg-purple-600 group-hover:text-white transition-colors">IQ</div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Sir Ikhlaq Qureshi</h3>
            <p class="text-xs font-bold text-purple-600 uppercase tracking-wider">English Language Specialist</p>
          </div>
        </div>
        <p class="text-sm text-slate-600 mb-4 flex-grow">
          His academic background in English Literature supports his focus on language learning, reading comprehension, literary studies, and written expression.
        </p>
        <div class="text-xs text-slate-500 bg-slate-50 p-2 rounded border border-slate-100">
          <strong>Qualifications:</strong> BS in English Literature<br>
          <strong>University:</strong> University of the Punjab, Lahore
        </div>
      </article>

      <!-- Urdu -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-pink-500 transition-colors group flex flex-col">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-pink-50 text-pink-600 rounded-xl flex items-center justify-center text-xl font-bold shrink-0 border border-pink-100 group-hover:bg-pink-600 group-hover:text-white transition-colors">AR</div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Ms. Ayesha Rehman</h3>
            <p class="text-xs font-bold text-pink-600 uppercase tracking-wider">Urdu Language Specialist</p>
          </div>
        </div>
        <p class="text-sm text-slate-600 mb-4 flex-grow">
          Her academic background in Urdu Language supports her focus on Urdu literature, language learning, grammar, and written expression.
        </p>
        <div class="text-xs text-slate-500 bg-slate-50 p-2 rounded border border-slate-100">
          <strong>Qualifications:</strong> BS in Urdu Language<br>
          <strong>University:</strong> Quaid-i-Azam University, Islamabad
        </div>
      </article>

      <!-- Pakistan Studies -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-cyan-500 transition-colors group flex flex-col">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-cyan-50 text-cyan-600 rounded-xl flex items-center justify-center text-xl font-bold shrink-0 border border-cyan-100 group-hover:bg-cyan-600 group-hover:text-white transition-colors">NB</div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Ms. Naima Batool</h3>
            <p class="text-xs font-bold text-cyan-600 uppercase tracking-wider">Pakistan Studies Specialist</p>
          </div>
        </div>
        <p class="text-sm text-slate-600 mb-4 flex-grow">
          With a postgraduate background in History, her subject focus supports educational content related to historical events, historical developments, and Pakistan Studies.
        </p>
        <div class="text-xs text-slate-500 bg-slate-50 p-2 rounded border border-slate-100">
          <strong>Qualifications:</strong> MPhil in History<br>
          <strong>University:</strong> University of Agriculture, Faisalabad
        </div>
      </article>

      <!-- Islamic Studies -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-teal-500 transition-colors group flex flex-col">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-teal-50 text-teal-600 rounded-xl flex items-center justify-center text-xl font-bold shrink-0 border border-teal-100 group-hover:bg-teal-600 group-hover:text-white transition-colors">AJ</div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Dr. Asrar Khan Janjua</h3>
            <p class="text-xs font-bold text-teal-600 uppercase tracking-wider">Islamic Studies Specialist</p>
          </div>
        </div>
        <p class="text-sm text-slate-600 mb-4 flex-grow">
          His academic background and ongoing doctoral research provide a foundation for his subject focus in Islamic Studies and religious education concepts.
        </p>
        <div class="text-xs text-slate-500 bg-slate-50 p-2 rounded border border-slate-100">
          <strong>Qualifications:</strong> PhD Scholar in Islamic Studies<br>
          <strong>University:</strong> Quaid-i-Azam University, Islamabad
        </div>
      </article>

    </div>
  </section>

  <!-- Comprehensive SEO Content -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="prose prose-slate prose-lg max-w-none">
      
      <h2 class="text-2xl font-extrabold text-slate-900 mb-4 border-b border-slate-200 pb-2">Our Academic Content Development Approach</h2>
      <p>TaleemMarkaz aims to make educational resources useful, understandable, and relevant to students' academic needs. Our content-development approach focuses on:</p>
      
      <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
        <div class="bg-slate-50 border border-slate-200 p-4 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-1">1. Subject-Based Development</h4>
          <p class="text-sm text-slate-600">Educational materials are organized around individual subjects, academic levels, and relevant syllabus topics.</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 p-4 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-1">2. Curriculum Awareness</h4>
          <p class="text-sm text-slate-600">Content is developed with consideration for Matric and Intermediate curricula. Specific board alignment is identified on resource pages.</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 p-4 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-1">3. Clear Explanations</h4>
          <p class="text-sm text-slate-600">We present difficult concepts in straightforward language so students can understand important topics effectively.</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 p-4 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-1">4. Content Quality Checks</h4>
          <p class="text-sm text-slate-600">Our editorial approach aims to improve clarity, subject relevance, formatting, and accuracy before publication.</p>
        </div>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-4 border-b border-slate-200 pb-2">Academic Resources for Pakistani Students</h2>
      <p>TaleemMarkaz aims to support students studying under different Pakistani educational boards and academic systems. Our educational content is intended to help students preparing for:</p>
      <ul class="list-disc pl-5">
        <li>Matric Part 1 – Class 9</li>
        <li>Matric Part 2 – Class 10</li>
        <li>Intermediate Part 1 – First Year</li>
        <li>Intermediate Part 2 – Second Year</li>
        <li>Secondary School Certificate (SSC) & Higher Secondary School Certificate (HSSC)</li>
        <li>Relevant IGCSE, O Level, and A Level subjects</li>
      </ul>
      <p><em>Students should always check the relevant resource page for its specific class, board, syllabus, and examination year.</em></p>

      <h2 class="text-2xl font-extrabold text-slate-900 mt-10 mb-6 border-b border-slate-200 pb-2">Frequently Asked Questions</h2>
      <div class="space-y-4 not-prose">
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">Who are the teachers and academic contributors at TaleemMarkaz?</h4>
          <p class="text-slate-600 text-sm">The TaleemMarkaz academic team includes contributors specializing in Biology, Chemistry, Mathematics, English, Urdu, History, Pakistan Studies, and Islamic Studies.</p>
        </div>
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">Does the academic team have international teaching experience?</h4>
          <p class="text-slate-600 text-sm">Malik Muhammad Ahsan Jahangir has experience teaching international students from the United Kingdom, United States, Canada, and Australia, including students following IGCSE, O Level, and A Level curricula.</p>
        </div>
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">Which subjects are covered by the academic team?</h4>
          <p class="text-slate-600 text-sm">The listed subject areas include Biology, Chemistry, Physics, Mathematics, English, Urdu, History, Pakistan Studies, and Islamic Studies.</p>
        </div>
        <div class="bg-white border border-slate-200 p-5 rounded-lg">
          <h4 class="font-bold text-slate-900 mb-2">How does TaleemMarkaz approach educational content quality?</h4>
          <p class="text-slate-600 text-sm">TaleemMarkaz aims to develop clear, relevant, and organized educational resources. Content review and syllabus alignment are identified according to the checks completed for each individual resource.</p>
        </div>
      </div>

      <div class="bg-blue-50 border border-blue-100 p-6 rounded-xl mt-10">
        <h3 class="font-bold text-blue-900 mb-2">Our Commitment to Students</h3>
        <p class="text-sm text-blue-800 leading-relaxed mb-0">At TaleemMarkaz, our goal is to make learning resources more accessible and easier to understand. Through subject-focused educational content, academic contributions, and a student-centered approach, we aim to support learners throughout their school and college education.</p>
      </div>

    </div>
  </section>
</Layout>